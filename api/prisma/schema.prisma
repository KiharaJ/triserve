// TriServe Prisma schema.
//
// Conventions (see /docs/DESIGN.md and /README.md):
//   - IDs: CHAR(36) UUIDs. `@default(uuid())` is generated by the Prisma
//     client in the app process (uuid v4) — satisfies the "app-generated,
//     never DB auto-increment" convention while staying declarative.
//   - Timestamps: DATETIME(3) stored in UTC
//   - Money: BIGINT minor units + CHAR(3) currency code — never floats
//   - Soft delete: nullable deleted_at on every row
//   - Audit: created_by / updated_by nullable FK -> users

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the extra targets cover managed-host build images
  // (Render/Railway/Fly run Debian/Ubuntu with OpenSSL 3.x or 1.1.x).
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (§3, §4.1)
// ---------------------------------------------------------------------------

// NOTE (E17b): `users.role` and `role_permissions.role` are plain VARCHAR role
// KEYS, not a DB enum, so companies can define custom roles beyond the seven
// built-ins. The registry of valid keys per company is the `roles` table; the
// seven built-ins are seeded there as system rows. @triserve/shared still
// carries the built-in keys, their labels and their default permission sets.

enum UserScope {
  branch
  group
}

/// Every gate-able action funnels through ONE approvals mechanism (§4.11/E8).
enum ApprovalType {
  PRICE_OVERRIDE
  REFUND
  INVENTORY_ADJUSTMENT
  STOCK_TRANSFER
  PURCHASE_ORDER
  WARRANTY_CANCELLATION
  INVOICE_VOID
  REOPEN_JOB
  LARGE_CASH_REFUND
  MANUAL_JOURNAL
  /// Admin overrides of the warranty/repair guards (§4.7). Each is requested
  /// when a guard blocks an action, and — once APPROVED — is spent by
  /// RETRYING that action with the approval id. See the approvals framework
  /// doc comment for the request → decide → retry pattern.
  CLAIM_SPLIT_MISMATCH
  OW_REPAIR_WITHOUT_QUOTE
  DUPLICATE_WARRANTY_CLAIM
  JOB_COVERAGE_CHANGE
  /// Proposal Module 4: a supervisor certifying a device Beyond Economic
  /// Repair, and the commercial swap that follows. Certification writes off a
  /// repair and can commit a replacement unit, so both are manager-gated.
  BER_CERTIFICATION
  DEVICE_SWAP
  /// Proposal Module 5: a commercial write-off above the actor's role ceiling
  /// (see `role_limits`) — the Centre Manager is the only approver.
  WRITE_OFF
  /// A technician asking for a part off the shelf. DECIDED THROUGH ITS OWN
  /// ENDPOINT (POST /jobs/{id}/parts/{lineId}/approve|reject), not the generic
  /// inbox: approving is what reserves the stock, and that can fail if the
  /// part has gone since the request. The generic inbox still LISTS it so
  /// approvers have one place to see everything pending.
  PARTS_REQUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Product/device category (§4.2): handheld (phones/tablets), consumer
/// electronics (TV/audio), air-con, refrigeration, other. Shared by
/// `models` and `devices` (and later `parts`).
enum DeviceCategory {
  HHP
  CE
  AC
  REF
  OTHER
}

/// Customer's preferred notification language (§4.2) — drives SMS templates.
enum PreferredLanguage {
  EN
  SW
}

/// Customer classification (§4.2). INDIVIDUAL and BUSINESS are retail; DEALER
/// is trade — DEALER is the single source for the `is_dealer` flag the POS /
/// pricing and invoice badges read (kept in sync on every write).
enum CustomerType {
  INDIVIDUAL
  BUSINESS
  DEALER
}

/// Warranty status of a job (§4.3). Legacy Y/N maps to IW/OW; GOODWILL is a
/// free repair outside warranty; UNKNOWN is the intake default until the
/// front desk / diagnosis resolves it.
enum WarrantyStatus {
  IW
  OW
  GOODWILL
  UNKNOWN
}

/// How the device reached us (Samsung SO "Service Type"). CARRY_IN is the
/// front-desk default; ADH is Accidental Damage Handling.
enum ServiceType {
  CARRY_IN
  PICKUP
  IN_HOME
  INITIAL_INSTALL
  INSPECTION
  INSURANCE
  PRODUCT_RETURN
  RETURN_HANDLING
  STOCK_REPAIR
  ADH
}

/// What the warranty actually PAYS FOR — the billing consequence of
/// `WarrantyStatus`, mirroring the four boxes on Samsung's job card.
/// Invoicing reads THIS, never `warrantyStatus`: LABOUR_ONLY still bills the
/// customer for parts, PARTS_ONLY still bills them for labour.
enum JobCoverage {
  FULL
  LABOUR_ONLY
  PARTS_ONLY
  NONE
}

/// WHY a job was ruled in/out of warranty — the evidence behind the decision,
/// which is what an audit or a rejected claim turns on. REGISTRATION = matched
/// a warranty_registration on serial; PURCHASE_DATE = derived from the device's
/// purchase date; MANUAL = front desk asserted it; GOODWILL = out of warranty
/// but repaired free as a favour (the shop absorbs the cost).
enum WarrantySource {
  REGISTRATION
  PURCHASE_DATE
  MANUAL
  GOODWILL
}

/// How urgently a job needs doing (§4.3).
///
/// An ENUM, unlike ServiceCategory: sorting and escalation depend on the
/// ORDER, so the set must be closed. It deliberately does NOT compute a due
/// date — turnaround comes from the service category's SLA; priority is the
/// signal a human triages by.
enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// The six GSPN diagnostic code axes sharing the `service_codes` table.
enum ServiceCodeKind {
  CONDITION
  SYMPTOM
  DEFECT
  DEFECT_TYPE
  DEFECT_BLOCK
  REPAIR
}

/// Account classes of the chart of accounts (§4.9 / E1).
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// What operational event produced a journal entry (§4.9 / E1). Only
/// MANUAL is writable today (Task 0.6); the others are switched on with
/// automatic posting in Phase 3 — the enum exists now so no schema rebuild
/// is needed then.
enum JournalSourceType {
  PAYMENT
  GRN
  SUPPLIER_PAYMENT
  WARRANTY
  ADJUSTMENT
  MANUAL
}

// ---------------------------------------------------------------------------
// Org / reference (§4.1)
// ---------------------------------------------------------------------------

model Company {
  id           String  @id @default(uuid()) @db.Char(36)
  name         String  @db.VarChar(255)
  legalName    String? @map("legal_name") @db.VarChar(255)
  tin          String? @db.VarChar(50)
  vrn          String? @db.VarChar(50)
  baseCurrency String  @default("TZS") @map("base_currency") @db.Char(3)
  logoUrl      String? @map("logo_url") @db.VarChar(500)
  address      String? @db.VarChar(500)
  phone        String? @db.VarChar(50)
  active       Boolean @default(true)

  /// Proposal Module 4: the Beyond-Economic-Repair trigger. A repair is
  /// flagged BER when (estimated parts + labour) reaches this percentage of
  /// the device's fair commercial market value. Per company because the
  /// economics differ by market — the proposal's 70% is the default.
  berThresholdPercent Int @default(70) @map("ber_threshold_percent")
  /// Proposal Module 6: how long a collection OTP stays valid, in minutes.
  otpTtlMinutes       Int @default(1440) @map("otp_ttl_minutes")
  /// Proposal Module 6: how many wrong PIN entries before the OTP is burned
  /// and must be re-issued (blocks brute-forcing a 6-digit code at the desk).
  otpMaxAttempts      Int @default(5) @map("otp_max_attempts")

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])

  branches          Branch[]
  users             User[]
  currencies        Currency[]
  paymentMethods    PaymentMethod[]
  faultCodes        FaultCode[]
  repairActions     RepairAction[]
  serviceCodes      ServiceCode[]
  serviceCategories ServiceCategory[]
  taxRates          TaxRate[]
  approvals         Approval[]
  approvalRules     ApprovalRule[]
  accounts          ChartOfAccount[]
  journalEntries    JournalEntry[]
  customers         Customer[]
  devices           Device[]
  deviceModels      DeviceModel[]
  jobs              Job[]
  attachments       Attachment[]

  workflowStates      WorkflowState[]
  workflowTransitions WorkflowTransition[]

  // Task 2.1 (§4.4): parts catalogue + per-branch stock + movement ledger.
  parts                 Part[]
  inventory             Inventory[]
  stockMovements        StockMovement[]
  // Task 2.2 (§4.5): parts committed to jobs.
  jobParts              JobPart[]
  // Task 2.3 (§4.4): inter-branch transfers.
  stockTransfers        StockTransfer[]
  // Task 2.5 (§4.4b): the vendors we buy spares from.
  suppliers             Supplier[]
  // Task 2.6 (§4.4b): orders sent to suppliers.
  purchaseOrders        PurchaseOrder[]
  // Task 2.7 (§4.4b): deliveries received against orders.
  grns                  GoodsReceivedNote[]
  // Task 2.4 (§4.4/E11): serial/batch tracked units.
  partUnits             PartUnit[]
  // Task 3.1 (§4.6): POS invoices.
  invoices              Invoice[]
  // Task 3.2 (§4.6): payments taken.
  payments              Payment[]
  // Task 4.1 (§4.7): warranty claims to Samsung.
  warrantyClaims        WarrantyClaim[]
  warrantyClaimLines    WarrantyClaimLine[]
  warrantyRegistrations WarrantyRegistration[]
  products              Product[]
  // E17: per-company overrides of the default role × permission matrix.
  rolePermissions       RolePermission[]
  // E17b: the company's role registry (built-in + custom).
  roles                 Role[]

  // -- SCMS proposal modules ------------------------------------------------
  symptomNodes          SymptomNode[] // M1 symptom tree
  conditionZones        ConditionZone[] // M1 condition-map hotspots
  jobConditionMarks     JobConditionMark[] // M1 recorded damage
  userSkills            UserSkill[] // M2 skill matrix
  jobStateEvents        JobStateEvent[] // M2 SLA/KPI clocks
  qcChecklistItems      QcChecklistItem[] // M2 calibration templates
  jobQcChecks           JobQcCheck[] // M2 calibration results
  berAssessments        BerAssessment[] // M4 BER
  swapUnits             SwapUnit[] // M4 swap buffer stock
  deviceSwaps           DeviceSwap[] // M4 replacements
  roleLimits            RoleLimit[] // M5 financial ceilings
  collectionOtps        JobCollectionOtp[] // M6 handover PINs
  consignments          Consignment[] // M6 totes/manifests
  consignmentJobs       ConsignmentJob[]
  consignmentScans      ConsignmentScan[]
  csatSurveys           CsatSurvey[] // M6 CSAT
  notificationTemplates NotificationTemplate[] // M7 templates
  notifications         Notification[] // M7 outbox + comms log

  @@map("companies")
}

model Branch {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  code      String  @db.VarChar(20)
  name      String  @db.VarChar(255)
  isHq      Boolean @default(false) @map("is_hq")
  address   String? @db.VarChar(500)
  phone     String? @db.VarChar(50)
  tzRegion  String? @map("tz_region") @db.VarChar(100)
  active    Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("BranchCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("BranchUpdatedBy", fields: [updatedById], references: [id])

  company            Company        @relation(fields: [companyId], references: [id])
  homeUsers          User[]         @relation("UserHomeBranch")
  approvals          Approval[]
  journalEntries     JournalEntry[]
  preferredCustomers Customer[]     @relation("CustomerPreferredBranch")
  jobs               Job[]
  attachments        Attachment[]

  // Task 2.1 (§4.4): per-branch stock rows + the branch's movement ledger.
  inventory             Inventory[]
  stockMovements        StockMovement[]
  // Task 2.3 (§4.4): transfers dispatched from / received at this branch.
  transfersOut          StockTransfer[]        @relation("TransferFromBranch")
  transfersIn           StockTransfer[]        @relation("TransferToBranch")
  // Task 2.6 (§4.4b): POs destined for this branch.
  purchaseOrders        PurchaseOrder[]
  // Task 2.7 (§4.4b): deliveries landed at this branch.
  grns                  GoodsReceivedNote[]
  // Task 2.4 (§4.4/E11): serial units currently located at this branch.
  partUnits             PartUnit[]
  // Task 3.1 (§4.6): invoices sold at this branch.
  invoices              Invoice[]
  // Task 3.2 (§4.6): payments taken at this branch.
  payments              Payment[]
  // Task 4.1 (§4.7): warranty claims filed at this branch.
  warrantyClaims        WarrantyClaim[]
  warrantyRegistrations WarrantyRegistration[]

  // -- SCMS proposal modules ------------------------------------------------
  jobStateEvents  JobStateEvent[] // M2 clocks (branch = job's branch)
  berAssessments  BerAssessment[] // M4
  swapUnits       SwapUnit[] // M4 swap buffer held here
  deviceSwaps     DeviceSwap[] // M4
  collectionOtps  JobCollectionOtp[] // M6
  consignmentsOut Consignment[]      @relation("ConsignmentFromBranch")
  consignmentsIn  Consignment[]      @relation("ConsignmentToBranch")
  csatSurveys     CsatSurvey[] // M6
  notifications   Notification[] // M7

  @@unique([companyId, code])
  @@map("branches")
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  companyId    String    @map("company_id") @db.Char(36)
  fullName     String    @map("full_name") @db.VarChar(255)
  initials     String?   @db.VarChar(10)
  email        String    @unique @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  /// A role KEY into the company's `roles` table (built-in or custom).
  role         String    @db.VarChar(50)
  homeBranchId String?   @map("home_branch_id") @db.Char(36)
  scope        UserScope @default(branch)
  totpSecret   String?   @map("totp_secret") @db.VarChar(255)
  totpEnabled  Boolean   @default(false) @map("totp_enabled")
  active       Boolean   @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id])

  company    Company @relation(fields: [companyId], references: [id])
  homeBranch Branch? @relation("UserHomeBranch", fields: [homeBranchId], references: [id])

  // Inverse sides of audit relations
  createdUsers             User[]            @relation("UserCreatedBy")
  updatedUsers             User[]            @relation("UserUpdatedBy")
  createdCompanies         Company[]         @relation("CompanyCreatedBy")
  updatedCompanies         Company[]         @relation("CompanyUpdatedBy")
  createdBranches          Branch[]          @relation("BranchCreatedBy")
  updatedBranches          Branch[]          @relation("BranchUpdatedBy")
  createdCurrencies        Currency[]        @relation("CurrencyCreatedBy")
  updatedCurrencies        Currency[]        @relation("CurrencyUpdatedBy")
  createdPaymentMethods    PaymentMethod[]   @relation("PaymentMethodCreatedBy")
  updatedPaymentMethods    PaymentMethod[]   @relation("PaymentMethodUpdatedBy")
  createdFaultCodes        FaultCode[]       @relation("FaultCodeCreatedBy")
  updatedFaultCodes        FaultCode[]       @relation("FaultCodeUpdatedBy")
  createdRepairActions     RepairAction[]    @relation("RepairActionCreatedBy")
  updatedRepairActions     RepairAction[]    @relation("RepairActionUpdatedBy")
  createdServiceCodes      ServiceCode[]     @relation("ServiceCodeCreatedBy")
  updatedServiceCodes      ServiceCode[]     @relation("ServiceCodeUpdatedBy")
  createdServiceCategories ServiceCategory[] @relation("ServiceCategoryCreatedBy")
  updatedServiceCategories ServiceCategory[] @relation("ServiceCategoryUpdatedBy")
  createdTaxRates          TaxRate[]         @relation("TaxRateCreatedBy")
  updatedTaxRates          TaxRate[]         @relation("TaxRateUpdatedBy")
  createdCustomers         Customer[]        @relation("CustomerCreatedBy")
  updatedCustomers         Customer[]        @relation("CustomerUpdatedBy")
  createdDevices           Device[]          @relation("DeviceCreatedBy")
  updatedDevices           Device[]          @relation("DeviceUpdatedBy")
  createdDeviceModels      DeviceModel[]     @relation("DeviceModelCreatedBy")
  updatedDeviceModels      DeviceModel[]     @relation("DeviceModelUpdatedBy")

  createdWorkflowStates      WorkflowState[]      @relation("WorkflowStateCreatedBy")
  updatedWorkflowStates      WorkflowState[]      @relation("WorkflowStateUpdatedBy")
  createdWorkflowTransitions WorkflowTransition[] @relation("WorkflowTransitionCreatedBy")
  updatedWorkflowTransitions WorkflowTransition[] @relation("WorkflowTransitionUpdatedBy")

  sessions             Session[]
  requestedApprovals   Approval[]     @relation("ApprovalRequestedBy")
  decidedApprovals     Approval[]     @relation("ApprovalApprovedBy")
  consumedApprovals    Approval[]     @relation("ApprovalConsumedBy")
  postedJournalEntries JournalEntry[] @relation("JournalEntryPostedBy")

  // Task 1.3 (§4.3): the several actor roles a user plays on a job.
  bookedJobs          Job[] @relation("JobBookedBy")
  engineerJobs        Job[] @relation("JobAssignedEngineer")
  dispatchedJobs      Job[] @relation("JobDispatchedBy")
  createdJobs         Job[] @relation("JobCreatedBy")
  updatedJobs         Job[] @relation("JobUpdatedBy")
  /// §4.7: who ruled this job in/out of warranty.
  warrantyDecidedJobs Job[] @relation("JobWarrantyDecidedBy")

  // Task 1.4 (§4.12): who uploaded a file.
  uploadedAttachments Attachment[] @relation("AttachmentUploadedBy")

  // Task 2.1 (§4.4): parts/inventory actor roles.
  createdParts     Part[]          @relation("PartCreatedBy")
  updatedParts     Part[]          @relation("PartUpdatedBy")
  createdInventory Inventory[]     @relation("InventoryCreatedBy")
  updatedInventory Inventory[]     @relation("InventoryUpdatedBy")
  movedStock       StockMovement[] @relation("StockMovementMovedBy")

  // Task 2.2 (§4.5): job-part actor roles.
  createdJobParts JobPart[] @relation("JobPartCreatedBy")
  updatedJobParts JobPart[] @relation("JobPartUpdatedBy")

  // Task 2.3 (§4.4): stock-transfer actor roles.
  dispatchedTransfers StockTransfer[] @relation("TransferDispatchedBy")
  receivedTransfers   StockTransfer[] @relation("TransferReceivedBy")
  createdTransfers    StockTransfer[] @relation("TransferCreatedBy")
  updatedTransfers    StockTransfer[] @relation("TransferUpdatedBy")

  // Task 2.5 (§4.4b): supplier actor roles.
  createdSuppliers Supplier[] @relation("SupplierCreatedBy")
  updatedSuppliers Supplier[] @relation("SupplierUpdatedBy")

  // Task 2.6 (§4.4b): purchase-order actor roles.
  approvedPurchaseOrders PurchaseOrder[] @relation("PoApprovedBy")
  createdPurchaseOrders  PurchaseOrder[] @relation("PoCreatedBy")
  updatedPurchaseOrders  PurchaseOrder[] @relation("PoUpdatedBy")

  // Task 2.7 (§4.4b): who received a delivery.
  receivedGrns GoodsReceivedNote[] @relation("GrnReceivedBy")

  // Task 2.4 (§4.4/E11): serial-unit actor roles.
  createdPartUnits PartUnit[] @relation("PartUnitCreatedBy")
  updatedPartUnits PartUnit[] @relation("PartUnitUpdatedBy")

  // Task 3.1 (§4.6): who sold an invoice.
  soldInvoices                 Invoice[]              @relation("InvoiceSoldBy")
  // Task 3.2 (§4.6): who took a payment.
  receivedPayments             Payment[]              @relation("PaymentReceivedBy")
  // Task 4.1 (§4.7): warranty claims created/updated by this user.
  createdWarrantyClaims        WarrantyClaim[]        @relation("WarrantyClaimCreatedBy")
  updatedWarrantyClaims        WarrantyClaim[]        @relation("WarrantyClaimUpdatedBy")
  createdWarrantyClaimLines    WarrantyClaimLine[]    @relation("WarrantyClaimLineCreatedBy")
  updatedWarrantyClaimLines    WarrantyClaimLine[]    @relation("WarrantyClaimLineUpdatedBy")
  createdWarrantyRegistrations WarrantyRegistration[] @relation("WarrantyRegCreatedBy")
  updatedWarrantyRegistrations WarrantyRegistration[] @relation("WarrantyRegUpdatedBy")
  createdProducts              Product[]              @relation("ProductCreatedBy")
  updatedProducts              Product[]              @relation("ProductUpdatedBy")

  // -- SCMS proposal modules ------------------------------------------------
  // M1 — intake evidence + the symptom/condition config behind it.
  conditionCapturedJobs        Job[]                  @relation("JobConditionCapturedBy")
  createdSymptomNodes          SymptomNode[]          @relation("SymptomNodeCreatedBy")
  updatedSymptomNodes          SymptomNode[]          @relation("SymptomNodeUpdatedBy")
  createdConditionZones        ConditionZone[]        @relation("ConditionZoneCreatedBy")
  updatedConditionZones        ConditionZone[]        @relation("ConditionZoneUpdatedBy")
  createdConditionMarks        JobConditionMark[]     @relation("JobConditionMarkCreatedBy")
  updatedConditionMarks        JobConditionMark[]     @relation("JobConditionMarkUpdatedBy")
  // M2 — skills + QC authority.
  skills                       UserSkill[]            @relation("UserSkillUser")
  createdUserSkills            UserSkill[]            @relation("UserSkillCreatedBy")
  updatedUserSkills            UserSkill[]            @relation("UserSkillUpdatedBy")
  createdQcChecklistItems      QcChecklistItem[]      @relation("QcChecklistItemCreatedBy")
  updatedQcChecklistItems      QcChecklistItem[]      @relation("QcChecklistItemUpdatedBy")
  recordedQcChecks             JobQcCheck[]           @relation("JobQcCheckRecordedBy")
  qcApprovedJobs               Job[]                  @relation("JobQcApprovedBy")
  // M3 — core exchange actors.
  issuedJobParts               JobPart[]              @relation("JobPartIssuedBy")
  coreReturnedJobParts         JobPart[]              @relation("JobPartCoreReturnedBy")
  requestedJobParts            JobPart[]              @relation("JobPartRequestedBy")
  issueRequestedJobParts       JobPart[]              @relation("JobPartIssueRequestedBy")
  approvedJobParts             JobPart[]              @relation("JobPartApprovedBy")
  rejectedJobParts             JobPart[]              @relation("JobPartRejectedBy")
  acknowledgedJobParts         JobPart[]              @relation("JobPartAcknowledgedBy")
  // M4 — BER + swaps.
  reviewedBerAssessments       BerAssessment[]        @relation("BerAssessmentReviewedBy")
  createdBerAssessments        BerAssessment[]        @relation("BerAssessmentCreatedBy")
  updatedBerAssessments        BerAssessment[]        @relation("BerAssessmentUpdatedBy")
  issuedSwapUnits              SwapUnit[]             @relation("SwapUnitIssuedBy")
  createdSwapUnits             SwapUnit[]             @relation("SwapUnitCreatedBy")
  updatedSwapUnits             SwapUnit[]             @relation("SwapUnitUpdatedBy")
  authorizedDeviceSwaps        DeviceSwap[]           @relation("DeviceSwapAuthorizedBy")
  createdDeviceSwaps           DeviceSwap[]           @relation("DeviceSwapCreatedBy")
  // M5 — role ceilings.
  createdRoleLimits            RoleLimit[]            @relation("RoleLimitCreatedBy")
  updatedRoleLimits            RoleLimit[]            @relation("RoleLimitUpdatedBy")
  // M6 — handover + logistics.
  verifiedCollectionOtps       JobCollectionOtp[]     @relation("JobCollectionOtpVerifiedBy")
  createdCollectionOtps        JobCollectionOtp[]     @relation("JobCollectionOtpCreatedBy")
  dispatchedConsignments       Consignment[]          @relation("ConsignmentDispatchedBy")
  arrivedConsignments          Consignment[]          @relation("ConsignmentArrivedBy")
  createdConsignments          Consignment[]          @relation("ConsignmentCreatedBy")
  updatedConsignments          Consignment[]          @relation("ConsignmentUpdatedBy")
  addedConsignmentJobs         ConsignmentJob[]       @relation("ConsignmentJobAddedBy")
  checkedInConsignmentJobs     ConsignmentJob[]       @relation("ConsignmentJobCheckedInBy")
  consignmentScans             ConsignmentScan[]      @relation("ConsignmentScanScannedBy")
  // M7 — notification templates.
  createdNotificationTemplates NotificationTemplate[] @relation("NotificationTemplateCreatedBy")
  updatedNotificationTemplates NotificationTemplate[] @relation("NotificationTemplateUpdatedBy")

  @@map("users")
}

/// Per-company override of the default role × permission matrix (E17).
///
/// The API ships a static default matrix in @triserve/shared
/// (`ROLE_PERMISSIONS`). This table stores only the DELTA a company has
/// applied on top of those defaults: one row per (role, permission) whose
/// effective grant differs from the default. `granted = true` adds a
/// permission the default withholds; `granted = false` revokes one the
/// default grants. A role with no rows resolves to its plain default, and a
/// permission added to the catalogue later is inherited until overridden.
/// SUPER_ADMIN is never stored here — it always holds every permission. For a
/// CUSTOM role (E17b) the default is empty, so every one of its permissions is
/// a `granted = true` row here.
model RolePermission {
  id         String  @id @default(uuid()) @db.Char(36)
  companyId  String  @map("company_id") @db.Char(36)
  /// A role KEY (built-in or custom) — see the `roles` table.
  role       String  @db.VarChar(50)
  /// A @triserve/shared permission string, e.g. "invoice.void".
  permission String  @db.VarChar(100)
  granted    Boolean

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, role, permission])
  @@index([companyId, role])
  @@map("role_permissions")
}

/// The registry of roles a company recognises (E17b). Seeds with the seven
/// built-ins (`is_system = true`, keys matching @triserve/shared's built-in
/// role names) and grows as admins add custom roles. `users.role` and
/// `role_permissions.role` reference `key` (not a hard FK — validated in the
/// service, consistent with how `users.role` was an enum before).
///
/// Built-in rows cannot be deleted or re-keyed (their permission SET is still
/// editable via role_permissions). Custom rows can be renamed and deleted when
/// no user holds them. SUPER_ADMIN additionally always holds every permission.
model Role {
  id          String  @id @default(uuid()) @db.Char(36)
  companyId   String  @map("company_id") @db.Char(36)
  /// UPPER_SNAKE role key, unique per company.
  key         String  @db.VarChar(50)
  label       String  @db.VarChar(100)
  description String? @db.VarChar(255)
  /// true for the seven built-ins; false for company-defined roles.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Approvals (§4.11 / E8, Task 0.5) — ONE generic gate for every sensitive
// action (refunds, voids, big discounts, POs, adjustments, job reopens, …).
// Later modules call ApprovalsService.request(...) BEFORE performing a gated
// action and proceed only once the row is APPROVED.
// ---------------------------------------------------------------------------

model Approval {
  id        String       @id @default(uuid()) @db.Char(36)
  companyId String       @map("company_id") @db.Char(36)
  branchId  String       @map("branch_id") @db.Char(36)
  type      ApprovalType

  /// The entity awaiting approval. NULLABLE on purpose: an approval may
  /// PRECEDE the entity it gates (e.g. approve a refund before the credit
  /// note row exists) — the caller backfills ref_id afterwards.
  refType String? @map("ref_type") @db.VarChar(100)
  refId   String? @map("ref_id") @db.Char(36)

  /// The proposed change (free-form, per type): e.g. {"amount": 15000000,
  /// "currency": "TZS"} for a REFUND, {"percent": 12} for a PRICE_OVERRIDE.
  payloadJson Json? @map("payload_json")

  requestedById String         @map("requested_by") @db.Char(36)
  approvedById  String?        @map("approved_by") @db.Char(36)
  status        ApprovalStatus @default(PENDING)
  /// Requester's justification (required, §4.11); a rejection reason
  /// replaces it on decide (the original is preserved in the audit trail).
  reason        String         @db.Text
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.DateTime(3)
  decidedAt     DateTime?      @map("decided_at") @db.DateTime(3)

  /// An APPROVED approval is SINGLE USE. Stamped by the action that spends
  /// it, so a one-off "yes" cannot be replayed into standing permission.
  consumedAt   DateTime? @map("consumed_at") @db.DateTime(3)
  consumedById String?   @map("consumed_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company     Company @relation(fields: [companyId], references: [id])
  branch      Branch  @relation(fields: [branchId], references: [id])
  requestedBy User    @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
  consumedBy  User?   @relation("ApprovalConsumedBy", fields: [consumedById], references: [id])

  @@index([companyId, status, type])
  @@index([companyId, type, status, consumedAt])
  @@index([companyId, branchId, status])
  @@index([refType, refId])
  @@map("approvals")
}

/// Per-company config backing ApprovalsService.isRequired(): when does a
/// given action type need a manager's sign-off? Thresholds are OR-ed —
/// amount >= threshold_amount, or percent >= threshold_percent. Amounts are
/// BIGINT minor units of the company base currency (money convention).
/// No rule / enabled=false → the action never requires approval.
model ApprovalRule {
  id               String       @id @default(uuid()) @db.Char(36)
  companyId        String       @map("company_id") @db.Char(36)
  type             ApprovalType
  thresholdAmount  BigInt?      @map("threshold_amount") @db.BigInt
  thresholdPercent Decimal?     @map("threshold_percent") @db.Decimal(6, 3)
  enabled          Boolean      @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, type])
  @@map("approval_rules")
}

// ---------------------------------------------------------------------------
// Audit log (§4.8, Task 0.4) — append-only record of every mutation
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  TRANSITION
  LOGIN
  APPROVE
  REJECT
  /// An APPROVED override was SPENT on the action it gated. Distinct from
  /// APPROVE: the decision and its use can be days apart, by different people.
  OVERRIDE_USED
}

/// Append-only. Written automatically by the audit Prisma extension
/// (api/src/prisma/audit.extension.ts) inside the same transaction as the
/// intercepted mutation; never updated or deleted (the extension throws on
/// any update/delete attempt against this model).
///
/// DELIBERATELY NO FOREIGN KEYS: audit rows must outlive the actors and
/// entities they describe (a hard-deleted user/branch must not cascade into
/// — or block — its audit trail). actor_user_id / entity_id are plain
/// CHAR(36) references resolved at read time.
model AuditLog {
  id          String      @id @default(uuid()) @db.Char(36)
  companyId   String      @map("company_id") @db.Char(36)
  branchId    String?     @map("branch_id") @db.Char(36)
  /// Null for system/seed writes made outside any request context.
  actorUserId String?     @map("actor_user_id") @db.Char(36)
  /// Prisma model name of the mutated entity, e.g. "Branch".
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String      @map("entity_id") @db.Char(36)
  action      AuditAction
  beforeJson  Json?       @map("before_json")
  afterJson   Json?       @map("after_json")
  at          DateTime    @default(now()) @db.DateTime(3)
  ip          String?     @db.VarChar(64)
  userAgent   String?     @map("user_agent") @db.VarChar(500)

  @@index([companyId, entityType, entityId])
  @@index([companyId, at])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Sessions — device/login history + refresh-token store (§11 / E18, Task 0.2)
// ---------------------------------------------------------------------------

model Session {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  // SHA-256 hex of the current (rotated) refresh token — the raw token is
  // never stored. A mismatch means the token was rotated/revoked → reject.
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ip               String?   @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.DateTime(3)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Accounting ledger (§4.9 / E1, Task 0.6) — TABLES ONLY for now.
//
// The double-entry tables exist from Phase 0 so automatic posting can be
// switched on in Phase 3 without a schema rebuild. Every entry is written
// EXCLUSIVELY through JournalService.post(), which enforces
// SUM(debit) == SUM(credit) in code and writes header + lines atomically.
// Manual journals are approval-gated (§4.11, type MANUAL_JOURNAL).
// ---------------------------------------------------------------------------

model ChartOfAccount {
  id        String      @id @default(uuid()) @db.Char(36)
  companyId String      @map("company_id") @db.Char(36)
  /// e.g. 1000 Cash, 1010 Bank, 1200 AR–Samsung, 2000 AP–Suppliers, 5000 COGS
  code      String      @db.VarChar(20)
  name      String      @db.VarChar(255)
  type      AccountType
  isActive  Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company Company       @relation(fields: [companyId], references: [id])
  lines   JournalLine[]

  @@unique([companyId, code])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  /// Nullable: company-level entries (e.g. year-end adjustments) have no branch.
  branchId  String? @map("branch_id") @db.Char(36)

  entryDate  DateTime          @map("entry_date") @db.Date
  sourceType JournalSourceType @map("source_type")
  /// Id of the operational row that produced this entry (payment, GRN, …).
  /// For MANUAL entries: the id of the MANUAL_JOURNAL approval that gated it.
  sourceId   String?           @map("source_id") @db.Char(36)
  memo       String?           @db.VarChar(500)
  postedById String            @map("posted_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company  Company       @relation(fields: [companyId], references: [id])
  branch   Branch?       @relation(fields: [branchId], references: [id])
  postedBy User          @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  lines    JournalLine[]

  @@index([companyId, entryDate])
  @@index([companyId, sourceType, sourceId])
  @@map("journal_entries")
}

/// The debits/credits of one entry. No company_id on purpose: lines are
/// reached ONLY via their (company-scoped) entry — see
/// company-scope.extension.ts. Money is BIGINT minor units; exactly one of
/// debit/credit is non-zero per line (enforced by JournalService.post).
model JournalLine {
  id        String @id @default(uuid()) @db.Char(36)
  entryId   String @map("entry_id") @db.Char(36)
  accountId String @map("account_id") @db.Char(36)
  debit     BigInt @default(0) @db.BigInt
  credit    BigInt @default(0) @db.BigInt
  currency  String @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  /// Restrict (never cascade): the ledger is append-only — an entry with
  /// lines cannot be deleted out from under them.
  entry   JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Customers & devices (§4.2, Task 1.1) — CRM 360 (E2) / device history (E3)
// foundations.
//
// SCOPING DECISION (documented): customers and devices are COMPANY-scoped,
// deliberately NOT branch-scoped. A customer belongs to the group and can be
// served at any branch (§4.2); `preferred_branch_id` is a CRM preference /
// analytics dimension, not an access boundary — branch-scoping would hide a
// walk-in customer's record (and their device history) from every other
// branch's front desk. Models are company-level config (like fault codes).
// ---------------------------------------------------------------------------

/// The `models` lookup (§4.2) — normalises the messy free-text model column
/// ("A05", "S23 Ultra", "UA40M5000", …). Named DeviceModel in Prisma to
/// avoid the confusing `prisma.model` delegate; the table is `models`.
model DeviceModel {
  id        String         @id @default(uuid()) @db.Char(36)
  companyId String         @map("company_id") @db.Char(36)
  modelCode String         @map("model_code") @db.VarChar(100)
  category  DeviceCategory
  brand     String         @default("Samsung") @db.VarChar(100)
  active    Boolean        @default(true)

  /// Proposal Module 4: fair commercial market value of a unit of this model,
  /// in BIGINT minor units of `market_value_currency`. The DENOMINATOR of the
  /// BER ratio. A per-device override lives on `devices.market_value` for
  /// units whose condition or age makes the model-level figure wrong.
  marketValue         BigInt? @map("market_value") @db.BigInt
  marketValueCurrency String? @map("market_value_currency") @db.Char(3)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("DeviceModelCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("DeviceModelUpdatedBy", fields: [updatedById], references: [id])

  company   Company    @relation(fields: [companyId], references: [id])
  devices   Device[]
  // SCMS Module 4: replacement units of this model held in the swap buffer.
  swapUnits SwapUnit[]

  @@unique([companyId, brand, modelCode])
  @@map("models")
}

/// Customers (§4.2 / E2). Lean record — the rich 360 profile is assembled by
/// the API from related tables later. `phone` keeps the exact user input;
/// `phone_normalized` / `alt_phone_normalized` hold the canonical E.164-ish
/// form produced by normalizePhone() and are what phone search hits.
model Customer {
  id                 String            @id @default(uuid()) @db.Char(36)
  companyId          String            @map("company_id") @db.Char(36)
  name               String            @db.VarChar(255)
  phone              String?           @db.VarChar(50)
  phoneNormalized    String?           @map("phone_normalized") @db.VarChar(50)
  altPhone           String?           @map("alt_phone") @db.VarChar(50)
  altPhoneNormalized String?           @map("alt_phone_normalized") @db.VarChar(50)
  email              String?           @db.VarChar(255)
  location           String?           @db.VarChar(255)
  /// Individual / Business / Dealer (§4.2). `isDealer` is derived from this
  /// (DEALER ⇒ true) and kept in sync on write for the POS/pricing code.
  type               CustomerType      @default(INDIVIDUAL) @map("customer_type")
  dealerName         String?           @map("dealer_name") @db.VarChar(255)
  isDealer           Boolean           @default(false) @map("is_dealer")
  preferredBranchId  String?           @map("preferred_branch_id") @db.Char(36)
  preferredLanguage  PreferredLanguage @default(EN) @map("preferred_language")
  /// 1–5 internal customer rating/flag.
  rating             Int?              @db.TinyInt
  notes              String?           @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])

  company               Company                @relation(fields: [companyId], references: [id])
  preferredBranch       Branch?                @relation("CustomerPreferredBranch", fields: [preferredBranchId], references: [id])
  devices               Device[]
  jobs                  Job[]
  invoices              Invoice[]
  warrantyRegistrations WarrantyRegistration[]
  // SCMS Module 6/7: satisfaction surveys + the comms log (§4.13).
  csatSurveys           CsatSurvey[]
  notifications         Notification[]

  @@index([companyId, phone])
  @@index([companyId, phoneNormalized])
  @@index([companyId, altPhoneNormalized])
  @@index([companyId, name])
  @@map("customers")
}

/// Devices (§4.2 / E3). `customer_id` is the CURRENT owner — ownership can
/// change, so `imei_serial` is indexed but deliberately NOT unique (the same
/// physical device may be re-registered; history persists across owners).
/// `model` stays free-text (legacy data is messy); `model_id` is the
/// normalised link to `models` when resolvable.
model Device {
  id           String         @id @default(uuid()) @db.Char(36)
  companyId    String         @map("company_id") @db.Char(36)
  customerId   String         @map("customer_id") @db.Char(36)
  brand        String         @default("Samsung") @db.VarChar(100)
  model        String?        @db.VarChar(150)
  modelId      String?        @map("model_id") @db.Char(36)
  category     DeviceCategory
  /// Flexible retail TYPE label (any brand/product): "Mobile", "Watch", "TV",
  /// "Laptop", "AC", "Two-Wheeler"… `category` stays the Samsung-repair grouping
  /// (HHP/CE/AC/REF/OTHER); device_type is the free display type for the register.
  deviceType   String?        @map("device_type") @db.VarChar(50)
  /// IMEI or serial number; nullable (some CE/AC units lack one). Stored
  /// cleaned (scientific-notation legacy values expanded, separators
  /// stripped, uppercased) — see normalizeImeiSerial().
  imeiSerial   String?        @map("imei_serial") @db.VarChar(100)
  color        String?        @db.VarChar(50)
  /// When the customer bought it (Samsung prints this on the job card). The
  /// primary input to the IW/OW ruling when no warranty_registration matches.
  purchaseDate DateTime?      @map("purchase_date") @db.Date

  /// Proposal Module 4 — per-unit override of `models.market_value` (minor
  /// units of `market_value_currency`). Set when this particular device's
  /// age/condition makes the model-level figure wrong.
  marketValue         BigInt? @map("market_value") @db.BigInt
  marketValueCurrency String? @map("market_value_currency") @db.Char(3)

  /// Proposal Module 4, step 5 (Primary Identity Realignment). When a device
  /// is swapped out, the ORIGINAL row is stamped `decommissioned_at` and
  /// pointed at its replacement via `replaced_by_device_id`; the replacement
  /// points BACK via `replaced_device_id`. Neither row is deleted — the
  /// device history (E3) walks the chain so the customer's full service
  /// record follows the IMEI change. Plain CHAR(36) self-references (no FK)
  /// so a chain can be written in either order.
  decommissionedAt   DateTime? @map("decommissioned_at") @db.DateTime(3)
  replacedByDeviceId String?   @map("replaced_by_device_id") @db.Char(36)
  replacedDeviceId   String?   @map("replaced_device_id") @db.Char(36)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("DeviceCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("DeviceUpdatedBy", fields: [updatedById], references: [id])

  company               Company                @relation(fields: [companyId], references: [id])
  customer              Customer               @relation(fields: [customerId], references: [id])
  deviceModel           DeviceModel?           @relation(fields: [modelId], references: [id])
  jobs                  Job[]
  warrantyRegistrations WarrantyRegistration[]
  // SCMS Module 4: the swap rows this device is on either side of.
  swappedOut            DeviceSwap[]           @relation("DeviceSwapOld")
  swappedIn             DeviceSwap[]           @relation("DeviceSwapNew")

  @@index([companyId, imeiSerial])
  @@index([customerId])
  @@index([replacedByDeviceId])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Configurable workflow engine (§4.10 / E7, Task 1.2)
//
// Job statuses and their allowed transitions are DATA, not a hardcoded enum,
// so each company can configure its own flow. The §5 lifecycle is the SEEDED
// DEFAULT workflow. Task 1.3 makes jobs.status an FK → workflow_states and
// validates every POST /jobs/{id}/transition through workflow_transitions.
// ---------------------------------------------------------------------------

/// One job status (a Kanban column). Unique per (company, code);
/// `is_initial` marks where new jobs start, `is_terminal` where they end,
/// `sort_order` drives board column ordering.
/// What a state MEANS to the clocks, independent of what a company calls it
/// (proposal Module 2, "Time Tracking (KPI Metrics)"). Renaming DIAGNOSING to
/// "Triage" must not break Clock-to-Diagnosis, so the metrics read `stage`,
/// never the code.
enum WorkflowStage {
  INTAKE
  DIAGNOSIS
  /// Waiting on something outside the bench — see {@link HoldKind}.
  HOLD
  REPAIR
  QC
  READY
  /// Terminal: dispatched, closed, cancelled, returned unrepaired.
  DONE
}

/// WHY a HOLD state is holding. Hold-for-Parts (HFP) sums PARTS holds only;
/// CUSTOMER holds are the "waiting for customer approval" pause. Both stop
/// the customer-facing SLA countdown; neither stops the internal clock.
enum HoldKind {
  NONE
  PARTS
  CUSTOMER
  /// Waiting on the manufacturer (warranty ruling, BER sign-off, swap unit).
  EXTERNAL
}

model WorkflowState {
  id         String  @id @default(uuid()) @db.Char(36)
  companyId  String  @map("company_id") @db.Char(36)
  code       String  @db.VarChar(50)
  label      String  @db.VarChar(100)
  isInitial  Boolean @default(false) @map("is_initial")
  isTerminal Boolean @default(false) @map("is_terminal")
  sortOrder  Int     @default(0) @map("sort_order")
  active     Boolean @default(true)

  /// Proposal Module 2: the semantic bucket this state falls in, driving the
  /// CTD / HFP / TAT metrics and the SLA colour bands.
  stage     WorkflowStage @default(INTAKE)
  holdKind  HoldKind      @default(NONE) @map("hold_kind")
  /// When true, time spent here does NOT burn the customer-facing SLA (the
  /// proposal's "any pause state halts customer SLA countdowns but runs an
  /// internal secondary tracking clock"). Defaults from `stage = HOLD` at
  /// seed time but is independently editable — a company may decide a
  /// parts hold IS on their clock.
  pausesSla Boolean       @default(false) @map("pauses_sla")

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("WorkflowStateCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("WorkflowStateUpdatedBy", fields: [updatedById], references: [id])

  company         Company              @relation(fields: [companyId], references: [id])
  transitionsFrom WorkflowTransition[] @relation("TransitionFromState")
  transitionsTo   WorkflowTransition[] @relation("TransitionToState")
  jobs            Job[]
  /// SCMS Module 2: occupancy rows recorded against this state.
  stateEvents     JobStateEvent[]      @relation("JobStateEventState")

  @@unique([companyId, code])
  @@map("workflow_states")
}

/// One legal edge in the state machine. `required_permission` is a
/// @triserve/shared permission string the acting user must hold (NULL = any
/// authenticated user with access to the job); `requires_approval` hooks the
/// generic approvals framework (§4.11); `guard_code` names a code-side guard
/// function in the workflow guard registry (e.g. 'ow_quote_approved') so new
/// business rules plug in WITHOUT schema changes.
model WorkflowTransition {
  id                 String  @id @default(uuid()) @db.Char(36)
  companyId          String  @map("company_id") @db.Char(36)
  fromStateId        String  @map("from_state_id") @db.Char(36)
  toStateId          String  @map("to_state_id") @db.Char(36)
  requiredPermission String? @map("required_permission") @db.VarChar(100)
  requiresApproval   Boolean @default(false) @map("requires_approval")
  guardCode          String? @map("guard_code") @db.VarChar(100)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("WorkflowTransitionCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("WorkflowTransitionUpdatedBy", fields: [updatedById], references: [id])

  company   Company       @relation(fields: [companyId], references: [id])
  fromState WorkflowState @relation("TransitionFromState", fields: [fromStateId], references: [id])
  toState   WorkflowState @relation("TransitionToState", fields: [toStateId], references: [id])

  @@unique([companyId, fromStateId, toStateId])
  @@index([toStateId])
  @@map("workflow_transitions")
}

// ---------------------------------------------------------------------------
// Configuration tables — per company (§4.14 / E17)
// ---------------------------------------------------------------------------

model Currency {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  code      String  @db.Char(3)
  name      String  @db.VarChar(100)
  symbol    String  @db.VarChar(10)
  isBase    Boolean @default(false) @map("is_base")

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("CurrencyCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("CurrencyUpdatedBy", fields: [updatedById], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("currencies")
}

model PaymentMethod {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  code      String  @db.VarChar(20)
  label     String  @db.VarChar(100)
  active    Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("PaymentMethodCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("PaymentMethodUpdatedBy", fields: [updatedById], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("payment_methods")
}

model FaultCode {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  code      String  @db.VarChar(30)
  label     String  @db.VarChar(255)
  active    Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("FaultCodeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("FaultCodeUpdatedBy", fields: [updatedById], references: [id])

  company      Company       @relation(fields: [companyId], references: [id])
  jobs         Job[]
  /// SCMS Module 1: symptom-tree leaves that resolve to this fault code.
  symptomNodes SymptomNode[]

  @@unique([companyId, code])
  @@map("fault_codes")
}

model RepairAction {
  id                 String  @id @default(uuid()) @db.Char(36)
  companyId          String  @map("company_id") @db.Char(36)
  code               String  @db.VarChar(30)
  label              String  @db.VarChar(255)
  // Money: BIGINT minor units (nullable — not every action has a default price)
  defaultLabourPrice BigInt? @map("default_labour_price") @db.BigInt
  defaultCurrency    String? @map("default_currency") @db.Char(3)
  active             Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("RepairActionCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("RepairActionUpdatedBy", fields: [updatedById], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("repair_actions")
}

/// A service line the centre offers (§4.3): what the customer is ASKING FOR
/// — mobile repair, TV repair, AC & refrigeration, general repair, and
/// whatever else a company adds.
///
/// DATA, not an enum, so a company adds its own lines (installation,
/// diagnostics-only, insurance work) without a migration — the same way
/// fault codes and workflow states already work.
///
/// Distinct from `devices.category` (Samsung's repair grouping, which drives
/// parts compatibility) and from `jobs.service_type` (HOW the device arrives).
model ServiceCategory {
  id              String  @id @default(uuid()) @db.Char(36)
  companyId       String  @map("company_id") @db.Char(36)
  code            String  @db.VarChar(30)
  label           String  @db.VarChar(255)
  /// Turnaround this line is normally promised in; NULL = no standard.
  defaultSlaHours Int?    @map("default_sla_hours")
  sortOrder       Int     @default(0) @map("sort_order")
  active          Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("ServiceCategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("ServiceCategoryUpdatedBy", fields: [updatedById], references: [id])

  company      Company       @relation(fields: [companyId], references: [id])
  jobs         Job[]
  /// SCMS Module 1/2: symptom-tree branches and technician skills narrowed
  /// to this service line.
  symptomNodes SymptomNode[]
  userSkills   UserSkill[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("service_categories")
}

/// Samsung GSPN diagnostic vocabulary (§4.7) — six code axes in one table,
/// discriminated by `kind`, because GSPN rejects a warranty claim that is
/// missing any of them (Condition, Symptom, Defect, Defect Type, Defect Block,
/// Repair).
///
/// Deliberately SEPARATE from `fault_codes` / `repair_actions`: those are the
/// customer-facing complaint vocabulary the front desk picks from and the job
/// card prints, priced in local currency. These are the Samsung-facing
/// engineering codes that travel on the claim. Same shape, different readers,
/// different lifecycles — merging them would force one list to serve both.
///
/// `category` optionally narrows a code to one device grouping; NULL applies
/// to all.
model ServiceCode {
  id        String          @id @default(uuid()) @db.Char(36)
  companyId String          @map("company_id") @db.Char(36)
  kind      ServiceCodeKind
  code      String          @db.VarChar(30)
  label     String          @db.VarChar(255)
  category  DeviceCategory?
  sortOrder Int             @default(0) @map("sort_order")
  active    Boolean         @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("ServiceCodeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("ServiceCodeUpdatedBy", fields: [updatedById], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  conditionJobs   Job[] @relation("JobConditionCode")
  symptomJobs     Job[] @relation("JobSymptomCode")
  defectJobs      Job[] @relation("JobDefectCode")
  defectTypeJobs  Job[] @relation("JobDefectType")
  defectBlockJobs Job[] @relation("JobDefectBlock")
  repairJobs      Job[] @relation("JobRepairCode")

  @@unique([companyId, kind, code])
  @@index([companyId, kind, active])
  @@map("service_codes")
}

model TaxRate {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  code      String  @db.VarChar(30)
  label     String  @db.VarChar(255)
  percent   Decimal @db.Decimal(6, 3)
  active    Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("TaxRateCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("TaxRateUpdatedBy", fields: [updatedById], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// Jobs (§4.3 / §5, Task 1.3) — the heart of the system.
//
// A job is a device brought in for service. It is created at the workflow
// INITIAL state (BOOKED — front-desk intake; the ASSIGNED ENGINEER moves it
// to RECEIVED once they physically have the device), carries a
// branch-prefixed human `job_no`
// (generated concurrency-safely via JobCounter), and moves through the
// configurable workflow (Task 1.2) EXCLUSIVELY via POST /jobs/{id}/transition
// — validated by WorkflowService. Jobs are COMPANY- AND BRANCH-scoped (a
// branch user only sees their branch; TECHNICIANs are further restricted in
// the service to jobs assigned to them). Mutations are audited; state moves
// additionally emit a semantic TRANSITION audit row.
//
// claim_id / invoice_id are nullable columns reserved for later phases
// (warranty_claims / invoices tables don't exist yet) — plain CHAR(36) with
// NO FK, mirroring how those links are backfilled once those modules land.
model Job {
  id                     String          @id @default(uuid()) @db.Char(36)
  companyId              String          @map("company_id") @db.Char(36)
  /// Human-friendly, branch-prefixed, unique per company: `DAR-2026-000123`.
  jobNo                  String          @map("job_no") @db.VarChar(50)
  /// Samsung SO / job-card number — stored as a CLEAN string (Excel
  /// scientific-notation like `4.29260291E9` is expanded on intake).
  soNumber               String?         @map("so_number") @db.VarChar(100)
  branchId               String          @map("branch_id") @db.Char(36)
  customerId             String          @map("customer_id") @db.Char(36)
  deviceId               String          @map("device_id") @db.Char(36)
  bookedById             String          @map("booked_by") @db.Char(36)
  assignedEngineerId     String?         @map("assigned_engineer_id") @db.Char(36)
  warrantyStatus         WarrantyStatus  @default(UNKNOWN) @map("warranty_status")
  serviceType            ServiceType     @default(CARRY_IN) @map("service_type")
  /// WHAT the customer is asking for (mobile repair, AC repair, …).
  serviceCategoryId      String?         @map("service_category_id") @db.Char(36)
  /// How urgently — the triage signal the board sorts by.
  priority               JobPriority     @default(NORMAL)
  /// INTERNAL target: received_at + the category's SLA. Deliberately NOT
  /// `returnByDate`, which is what was PROMISED TO THE CUSTOMER — the two
  /// differ constantly, and merging them would make "are we late?" and "did
  /// we let the customer down?" the same question.
  slaDueAt               DateTime?       @map("sla_due_at") @db.DateTime(3)
  /// The BILLING consequence of the warranty ruling — see {@link JobCoverage}.
  /// Invoicing and the `ow_quote_approved` workflow guard read this field.
  coverage               JobCoverage     @default(NONE)
  /// Evidence behind the ruling, plus who made it and when. A bare dropdown
  /// pick is indistinguishable from a registration match without this.
  warrantySource         WarrantySource? @map("warranty_source")
  warrantyRegistrationId String?         @map("warranty_registration_id") @db.Char(36)
  warrantyDecidedById    String?         @map("warranty_decided_by") @db.Char(36)
  warrantyDecidedAt      DateTime?       @map("warranty_decided_at") @db.DateTime(3)
  faultReported          String?         @map("fault_reported") @db.Text
  faultCodeId            String?         @map("fault_code_id") @db.Char(36)
  techReport             String?         @map("tech_report") @db.Text

  // -- Proposal Module 1: structured intake ---------------------------------
  /// The LEAF of the cascading symptom tree the agent picked
  /// (Category → Sub-category → Symptom trigger). Replaces "phone broken" as
  /// free text with data downstream routing and BI can actually use;
  /// `fault_reported` survives as the customer's own words.
  symptomNodeId          String?   @map("symptom_node_id") @db.Char(36)
  /// Stamped once the agent has completed the visual condition map. NULL
  /// means the damage walk-through never happened — the intake-evidence guard
  /// refuses to let the job leave the counter.
  conditionCapturedAt    DateTime? @map("condition_captured_at") @db.DateTime(3)
  conditionCapturedById  String?   @map("condition_captured_by") @db.Char(36)
  /// Liquid-damage indicator observed at intake. Tri-state on purpose: NULL =
  /// not checked, false = checked and clean, true = tripped. "Not checked"
  /// and "clean" must never look the same in a warranty dispute.
  liquidIndicatorTripped Boolean?  @map("liquid_indicator_tripped")
  /// Proposal Module 1, step 5: the preliminary OW estimate shown to the
  /// customer BEFORE they signed, in minor units of `estimate_currency`.
  /// Preserved separately from any later quote/invoice so "what were they
  /// told at the counter" stays answerable.
  estimateAmount         BigInt?   @map("estimate_amount") @db.BigInt
  estimateCurrency       String?   @map("estimate_currency") @db.Char(3)
  /// When the customer accepted the service terms, data-loss disclaimer and
  /// disposal policy. The signature itself is an attachment (kind SIGNATURE).
  termsAcceptedAt        DateTime? @map("terms_accepted_at") @db.DateTime(3)

  // -- Proposal Module 2: bench clocks + QC ---------------------------------
  /// First entry into a DIAGNOSIS-stage state — the end of Clock-to-Diagnosis
  /// and the start of the SLA labour timer.
  diagnosisStartedAt DateTime? @map("diagnosis_started_at") @db.DateTime(3)
  /// First entry into a REPAIR-stage state.
  repairStartedAt    DateTime? @map("repair_started_at") @db.DateTime(3)
  /// Most recent submission for verification (IN_REPAIR → QC).
  qcSubmittedAt      DateTime? @map("qc_submitted_at") @db.DateTime(3)
  /// Actual hands-on labour the technician declares when submitting for QC —
  /// mandatory (guard `repair_work_declared`). DECIMAL, not money.
  labourHours        Decimal?  @map("labour_hours") @db.Decimal(6, 2)
  /// The Quality Assurer's mandatory reason on the most recent QC rejection.
  qcFailureReason    String?   @map("qc_failure_reason") @db.Text
  /// How many times QC has bounced this job — the first-time-fix metric.
  qcRejectCount      Int       @default(0) @map("qc_reject_count")
  qcApprovedById     String?   @map("qc_approved_by") @db.Char(36)
  qcApprovedAt       DateTime? @map("qc_approved_at") @db.DateTime(3)

  /// Proposal Modules 4 & 5: the bench is LOCKED OUT. Set when a BER review
  /// transfers ownership to the supervisor, or when an OW job is holding for
  /// the customer's quote decision. While true the technician may read the
  /// job but not mutate it or move it forward.
  techLocked     Boolean @default(false) @map("tech_locked")
  techLockReason String? @map("tech_lock_reason") @db.VarChar(255)

  /// GSPN diagnostic codes (§4.7) — all six are required to file a claim.
  /// FKs → service_codes; `repairDescription` is the free-text counterpart to
  /// `repairCode` that GSPN prints as "Repair Description".
  conditionCodeId   String? @map("condition_code_id") @db.Char(36)
  symptomCodeId     String? @map("symptom_code_id") @db.Char(36)
  defectCodeId      String? @map("defect_code_id") @db.Char(36)
  defectTypeId      String? @map("defect_type_id") @db.Char(36)
  defectBlockId     String? @map("defect_block_id") @db.Char(36)
  repairCodeId      String? @map("repair_code_id") @db.Char(36)
  repairDescription String? @map("repair_description") @db.Text

  /// Accessories handed in WITH the device (e.g. "SIM TRAY") — job-card T&C 2
  /// makes these a custody liability, so they are recorded at intake.
  accessoriesHeld     String?   @map("accessories_held") @db.VarChar(500)
  /// Booked slot for PICKUP / IN_HOME service types.
  appointmentAt       DateTime? @map("appointment_at") @db.DateTime(3)
  /// Promised return date shown to the customer on the job card.
  returnByDate        DateTime? @map("return_by_date") @db.Date
  /// Our own 90-day guarantee on the repair (job-card T&C 10) — completion
  /// + 90d. Makes a return visit recognisable as rework, not a fresh paid job.
  repairWarrantyUntil DateTime? @map("repair_warranty_until") @db.Date
  /// FK → workflow_states — the job's current lifecycle status (§4.10).
  stateId             String    @map("state_id") @db.Char(36)
  /// Despite the name, this is BOOKING time (front-desk intake, the workflow
  /// INITIAL state) — kept as `received_at` because it already drives the
  /// SLA intake-stage clock and reports computed from it. For when the
  /// ENGINEER received the device, see `engineerReceivedAt` / the RECEIVED
  /// workflow state.
  receivedAt          DateTime  @map("received_at") @db.DateTime(3)
  /// Stamped on first entry to the RECEIVED workflow state — the assigned
  /// engineer's own attestation that they physically have the device.
  engineerReceivedAt  DateTime? @map("engineer_received_at") @db.DateTime(3)
  readyAt             DateTime? @map("ready_at") @db.DateTime(3)
  dispatchedAt        DateTime? @map("dispatched_at") @db.DateTime(3)
  dispatchedById      String?   @map("dispatched_by") @db.Char(36)
  receivedByCustomer  String?   @map("received_by_customer") @db.VarChar(255)
  waybillNo           String?   @map("waybill_no") @db.VarChar(100)
  /// Reserved for later phases (no FK — target tables don't exist yet).
  claimId             String?   @map("claim_id") @db.Char(36)
  invoiceId           String?   @map("invoice_id") @db.Char(36)
  notes               String?   @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company          Company       @relation(fields: [companyId], references: [id])
  branch           Branch        @relation(fields: [branchId], references: [id])
  customer         Customer      @relation(fields: [customerId], references: [id])
  device           Device        @relation(fields: [deviceId], references: [id])
  bookedBy         User          @relation("JobBookedBy", fields: [bookedById], references: [id])
  assignedEngineer User?         @relation("JobAssignedEngineer", fields: [assignedEngineerId], references: [id])
  faultCode        FaultCode?    @relation(fields: [faultCodeId], references: [id])
  state            WorkflowState @relation(fields: [stateId], references: [id])
  dispatchedBy     User?         @relation("JobDispatchedBy", fields: [dispatchedById], references: [id])
  createdBy        User?         @relation("JobCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?         @relation("JobUpdatedBy", fields: [updatedById], references: [id])

  serviceCategory      ServiceCategory?      @relation(fields: [serviceCategoryId], references: [id])
  warrantyRegistration WarrantyRegistration? @relation(fields: [warrantyRegistrationId], references: [id])
  warrantyDecidedBy    User?                 @relation("JobWarrantyDecidedBy", fields: [warrantyDecidedById], references: [id])

  conditionCode ServiceCode? @relation("JobConditionCode", fields: [conditionCodeId], references: [id])
  symptomCode   ServiceCode? @relation("JobSymptomCode", fields: [symptomCodeId], references: [id])
  defectCode    ServiceCode? @relation("JobDefectCode", fields: [defectCodeId], references: [id])
  defectType    ServiceCode? @relation("JobDefectType", fields: [defectTypeId], references: [id])
  defectBlock   ServiceCode? @relation("JobDefectBlock", fields: [defectBlockId], references: [id])
  repairCode    ServiceCode? @relation("JobRepairCode", fields: [repairCodeId], references: [id])

  // Task 2.2 (§4.5): parts reserved/consumed on this job.
  parts          JobPart[]
  // Task 3.1 (§4.6): invoices for this repair.
  invoices       Invoice[]
  // Task 4.1 (§4.7): warranty (IW) claims for this repair.
  warrantyClaims WarrantyClaim[]

  // -- Proposal modules -----------------------------------------------------
  symptomNode         SymptomNode?       @relation(fields: [symptomNodeId], references: [id])
  conditionCapturedBy User?              @relation("JobConditionCapturedBy", fields: [conditionCapturedById], references: [id])
  qcApprovedBy        User?              @relation("JobQcApprovedBy", fields: [qcApprovedById], references: [id])
  /// Module 1: the visual damage map captured at the counter.
  conditionMarks      JobConditionMark[]
  /// Module 2: the append-only state log the SLA/KPI clocks are computed from.
  stateEvents         JobStateEvent[]
  /// Module 2: calibration / flash / structural checks recorded at QC.
  qcChecks            JobQcCheck[]
  /// Module 4: BER evaluations (one per evaluation run; latest wins).
  berAssessments      BerAssessment[]
  /// Module 4: the replacement, if this repair resolved as a swap.
  deviceSwaps         DeviceSwap[]
  /// Module 6: single-use collection PINs issued for this job.
  collectionOtps      JobCollectionOtp[]
  /// Module 6: consignment memberships (satellite ↔ hub legs).
  consignmentJobs     ConsignmentJob[]
  /// Module 6: the post-closure satisfaction survey.
  csatSurveys         CsatSurvey[]
  /// Module 7: everything ever sent to the customer about this job.
  notifications       Notification[]

  @@unique([companyId, jobNo])
  @@index([companyId, branchId, stateId])
  @@index([companyId, assignedEngineerId])
  @@index([companyId, receivedAt])
  @@index([companyId, coverage])
  @@index([companyId, priority])
  @@index([companyId, slaDueAt])
  @@index([serviceCategoryId])
  @@index([customerId])
  @@index([deviceId])
  @@index([warrantyRegistrationId])
  @@map("jobs")
}

/// Per-(company, branch, year) monotonic counter backing concurrency-safe
/// job_no generation (§4.3). Incremented atomically via a single MySQL
/// `INSERT … ON DUPLICATE KEY UPDATE next_seq = LAST_INSERT_ID(next_seq + 1)`
/// inside an interactive transaction, so N parallel job creates get N
/// distinct sequential numbers with no dupes (the @@unique row lock
/// serializes the increment). Accessed ONLY via raw SQL — it deliberately
/// has NO relations and is NOT audited (an internal sequence, not business
/// data). The unique constraint on jobs.job_no is the ultimate backstop.
model JobCounter {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  year      Int
  nextSeq   Int    @default(0) @map("next_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([companyId, branchId, year])
  @@map("job_counters")
}

// ---------------------------------------------------------------------------
// Attachments (§4.12 / E4, Task 1.4) — polymorphic file store.
//
// Files themselves NEVER touch the DB: `file_url` holds the object-storage
// KEY (e.g. `{companyId}/JOB/{jobId}/{uuid}.jpg`), not a browsable URL —
// StorageService mints a fresh, short-lived presigned/signed GET URL on
// every read (list/upload response), so the API is the only thing that ever
// needs real storage credentials.
//
// owner_type/owner_id is a polymorphic reference (like AuditLog's
// entityType/entityId) — deliberately NOT an FK, since one column can't
// point at five different tables. Existence + access is validated in
// AttachmentsService before the row is written (load the JOB/CUSTOMER/
// DEVICE and check company/branch scope); GRN/INVOICE owners are accepted
// by the enum for forward-compatibility with §4.4b/§4.6 but those tables
// don't exist yet in this phase, so no existence check runs for them yet —
// add one the day those modules land.
// ---------------------------------------------------------------------------

enum AttachmentOwnerType {
  JOB
  CUSTOMER
  DEVICE
  GRN
  INVOICE
}

enum AttachmentKind {
  SIGNATURE
  PHOTO_BEFORE
  PHOTO_AFTER
  VIDEO
  WARRANTY_CARD
  PURCHASE_RECEIPT
  DOC
}

/// Polymorphic file store (§4.12). No `deleted_at`: DELETE /attachments/{id}
/// is a REAL delete of both the object AND the row (the design explicitly
/// wants the object gone, not just hidden) — the audit extension's DELETE
/// row is the historical record, not a soft-delete flag.
///
/// BRANCH SCOPING CHOICE (documented tradeoff): `branch_id` is derived from
/// the owning JOB at upload time (nullable — CUSTOMER/DEVICE owners are
/// company-level, so their attachments carry branch_id = NULL and stay
/// visible group-wide within the company, matching how Customer/Device
/// themselves are NOT branch-scoped). Attachment is deliberately **NOT**
/// added to `BRANCH_SCOPED_MODELS` in company-scope.extension.ts: that
/// extension tightens reads with a blunt `branchId = user.homeBranchId`
/// equality clause, which would also exclude the legitimate `branchId =
/// NULL` (company-level) rows for a branch-scoped user — the opposite of
/// what §4.12 wants. Instead AttachmentsService applies the correct
/// `OR: [{ branchId: null }, { branchId: user.homeBranchId }]` filter
/// itself for scope='branch' users, in both list() and the single-row
/// lookup used by delete(). Company scoping (`company_id`) IS handled by
/// the generic extension as normal (Attachment IS in COMPANY_SCOPED_MODELS).
model Attachment {
  id           String              @id @default(uuid()) @db.Char(36)
  companyId    String              @map("company_id") @db.Char(36)
  /// Derived from the owning Job at upload time; NULL for company-level
  /// owners (CUSTOMER/DEVICE) — see branch-scoping note above.
  branchId     String?             @map("branch_id") @db.Char(36)
  ownerType    AttachmentOwnerType @map("owner_type")
  ownerId      String              @map("owner_id") @db.Char(36)
  kind         AttachmentKind
  /// Object-storage KEY (not a public URL) — see file header note.
  fileUrl      String              @map("file_url") @db.VarChar(1024)
  fileName     String              @map("file_name") @db.VarChar(255)
  mimeType     String              @map("mime_type") @db.VarChar(100)
  sizeBytes    Int                 @map("size_bytes")
  uploadedById String              @map("uploaded_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company    Company @relation(fields: [companyId], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id])
  uploadedBy User    @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([companyId, ownerType, ownerId])
  @@index([companyId, branchId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Parts / inventory (§4.4 / E10, Task 2.1) — the ledger-backed stock model.
//
// THREE tables, one invariant:
//   - `parts`           — the company-level catalogue (one row per part
//                         number), like `models`: COMPANY-scoped, NOT branch.
//   - `inventory`       — stock buckets PER (branch, part): the materialized
//                         view read by every screen. COMPANY- AND BRANCH-scoped.
//   - `stock_movements` — the APPEND-ONLY ledger that is the SOURCE OF TRUTH
//                         for the buckets (like journal_lines for the ledger).
//
// Available stock (E10) = qty_on_hand − qty_reserved − qty_damaged. Every
// stock change goes through InventoryService.applyMovement(), which writes ONE
// stock_movements row AND updates the inventory buckets ATOMICALLY in a single
// transaction — so the buckets can always be rebuilt from the ledger
// (reconcile()), and no screen ever sees a movement without its bucket effect.
//
// Neither `inventory` nor `stock_movements` is in AUDITED_MODELS: the movement
// ledger IS inventory's audit trail (every bucket change is a movement row
// carrying moved_by/moved_at/reason), and auditing rows written inside
// applyMovement()'s own transaction would violate the audit extension's
// "no caller-managed transaction" rule. `parts` (infrequent catalogue edits,
// never written inside a tx) IS audited like `models`.
// ---------------------------------------------------------------------------

/// What operational event produced a stock movement (§4.4). Signed `qty`:
/// RECEIPT/TRANSFER_IN/RETURN/UNRESERVE are inbound (+), CONSUMPTION/
/// TRANSFER_OUT/SALE/SUPPLIER_RETURN/RESERVE/DAMAGE are outbound of their
/// bucket (−). ADJUSTMENT can be either sign (stock count correction).
enum StockMovementType {
  RECEIPT
  CONSUMPTION
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  SALE
  RETURN
  SUPPLIER_RETURN
  RESERVE
  UNRESERVE
  DAMAGE
  /// Proposal Module 3: a defective "core" component scanned back in against
  /// the job that replaced it. Inbound (+) into `qty_core_returned`, which is
  /// a HOLDING bucket outside available stock — the unit is destined for the
  /// manufacturer, not the shelf.
  CORE_RETURN
  /// The core leaving for the manufacturer (or being scrapped), closing the
  /// loop: outbound (−) from `qty_core_returned`.
  CORE_DISPATCH
}

/// The kind of source document a movement links back to via ref_id (§4.4).
/// GRN links a receipt to its goods-received note (and through it the PO /
/// supplier). Tables for JOB exist; GRN/TRANSFER/POS_SALE arrive in later
/// Phase-2/3 tasks — the enum is complete now so no rebuild is needed then.
enum StockRefType {
  JOB
  GRN
  TRANSFER
  POS_SALE
  COUNT
  ADJUSTMENT
}

/// The spare-parts catalogue (§4.4). One row per part number per company.
/// Money is BIGINT minor units + a currency: `unit_cost_usd` is the landed
/// cost in USD cents (Samsung parts are priced in USD), `default_sell_price_tzs`
/// the OW counter price in TZS minor units. `compatible_models` is a JSON
/// array of model codes it fits (§4.4 "text[] / join") — kept denormalized for
/// now; a `part_models` join can replace it without touching callers.
model Part {
  id                  String         @id @default(uuid()) @db.Char(36)
  companyId           String         @map("company_id") @db.Char(36)
  partNumber          String         @map("part_number") @db.VarChar(100)
  description         String         @db.VarChar(500)
  category            DeviceCategory
  unitCostUsd         BigInt?        @map("unit_cost_usd") @db.BigInt
  sellPriceTzs        BigInt?        @map("default_sell_price_tzs") @db.BigInt
  compatibleModels    Json?          @map("compatible_models")
  isSerialized        Boolean        @default(false) @map("is_serialized")
  /// Proposal Module 3: a "core exchange" part. Global brand compliance
  /// mandates a 1:1 replacement ratio for high-value tracked components
  /// (displays, PBA mainboards, cameras) — the OLD unit must come back to
  /// secure the credit. When true, the job cannot reach QC until the
  /// defective core has been scanned in (guard `core_returns_complete`).
  requiresCoreReturn  Boolean        @default(false) @map("requires_core_return")
  /// Preferred supplier (§4.4b) — drives suggested-reorder grouping. FK added
  /// in Task 2.5 now that `suppliers` exists (see `preferredSupplier` below).
  preferredSupplierId String?        @map("preferred_supplier_id") @db.Char(36)
  active              Boolean        @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("PartCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("PartUpdatedBy", fields: [updatedById], references: [id])

  company            Company             @relation(fields: [companyId], references: [id])
  preferredSupplier  Supplier?           @relation(fields: [preferredSupplierId], references: [id])
  inventory          Inventory[]
  movements          StockMovement[]
  jobParts           JobPart[]
  transferLines      StockTransferLine[]
  poLines            PurchaseOrderLine[]
  grnLines           GrnLine[]
  warrantyClaimLines WarrantyClaimLine[]
  units              PartUnit[]
  invoiceLines       InvoiceLine[]

  @@unique([companyId, partNumber])
  @@index([companyId, category])
  @@index([preferredSupplierId])
  @@map("parts")
}

/// Lifecycle of a part committed to a job (§4.5, Task 2.2). RESERVED holds
/// available stock the moment a part is added to a job (so two technicians
/// can't both promise the last unit); CONSUMED is written when the part is
/// physically installed — that releases the reservation AND removes the unit
/// from on-hand stock (an UNRESERVE + a CONSUMPTION through applyMovement).
/// Proposal Module 3 extends this into the full core-exchange chain:
/// RESERVED (allocated, still on the shelf) → ISSUED (physically picked from
/// its bin and handed to the technician) → CONSUMED (installed). CANCELLED
/// releases the reservation without consuming.
/// The bench parts lifecycle. A technician REQUESTS, an approver approves
/// (which is what RESERVES the stock), stores ISSUES it, the technician
/// ACKNOWLEDGES receipt, and fitting it CONSUMES it.
///
/// Stock is deliberately held at APPROVAL, not at request: an unapproved
/// request must never lock inventory another job could use. The corollary is
/// that approving can fail when the part has gone in the meantime — which is
/// why approval is an explicit, failable action rather than a side effect of
/// the generic approvals inbox.
enum JobPartStatus {
  /// Asked for by the bench; nothing held yet, awaiting the parts clerk.
  REQUESTED
  /// The parts clerk checked the request against the shelf and raised it for
  /// approval. This is the state an approver acts on — the clerk, not the
  /// engineer, decides what actually gets put in front of a manager.
  ISSUE_REQUESTED
  /// Approved — this is where the RESERVE movement fires.
  RESERVED
  /// Picked and physically handed over by stores ("Issued to Tech").
  ISSUED
  /// The technician has confirmed the part is in their hands.
  ACKNOWLEDGED
  CONSUMED
  CANCELLED
  /// An approver declined the request; terminal, carries a reason.
  REJECTED
}

/// A part committed to a job (§4.5). Adding a line RESERVES branch stock;
/// consuming it fires a CONSUMPTION (ref_type JOB) through
/// InventoryService.applyMovement. Money is BIGINT minor units + currency.
/// Like `inventory`, JobPart is DELIBERATELY NOT audited by the extension: the
/// line is written inside applyMovement's transaction, and the stock_movements
/// ledger (RESERVE/UNRESERVE/CONSUMPTION rows, ref_id = the job) is its audit
/// trail. It carries no branch_id — the affected branch is the job's branch,
/// and access is always gated through the (branch-scoped) parent job.
model JobPart {
  id            String        @id @default(uuid()) @db.Char(36)
  companyId     String        @map("company_id") @db.Char(36)
  jobId         String        @map("job_id") @db.Char(36)
  partId        String        @map("part_id") @db.Char(36)
  qty           Int
  unitSellPrice BigInt?       @map("unit_sell_price") @db.BigInt
  currency      String?       @db.Char(3)
  isWarranty    Boolean       @default(false) @map("is_warranty")
  status        JobPartStatus @default(REQUESTED)
  /// When the APPROVAL fired the RESERVE movement. NULL while REQUESTED or
  /// REJECTED — nothing is held then.
  reservedAt    DateTime?     @map("reserved_at") @db.DateTime(3)
  consumedAt    DateTime?     @map("consumed_at") @db.DateTime(3)

  // -- The bench request → approval → hand-over trail ------------------------
  /// Who asked for the part, and when. Set on creation and never cleared.
  requestedAt        DateTime  @default(now()) @map("requested_at") @db.DateTime(3)
  requestedById      String?   @map("requested_by") @db.Char(36)
  /// Why the bench needs it — shown to the approver deciding the request.
  requestNote        String?   @map("request_note") @db.VarChar(500)
  /// The parts clerk raising the bench's request for approval, having checked
  /// it against the shelf. The engineer asks; the clerk decides what actually
  /// reaches a manager's queue.
  issueRequestedAt   DateTime? @map("issue_requested_at") @db.DateTime(3)
  issueRequestedById String?   @map("issue_requested_by") @db.Char(36)
  /// The PENDING/decided `approvals` row this line is gated on. One approval
  /// per line, so a partially-approved multi-part request is expressible.
  /// Raised by the CLERK, not the engineer.
  approvalId         String?   @map("approval_id") @db.Char(36)
  approvedAt         DateTime? @map("approved_at") @db.DateTime(3)
  approvedById       String?   @map("approved_by") @db.Char(36)
  rejectedAt         DateTime? @map("rejected_at") @db.DateTime(3)
  rejectedById       String?   @map("rejected_by") @db.Char(36)
  /// Mandatory on rejection — the bench must be told why.
  rejectionReason    String?   @map("rejection_reason") @db.VarChar(500)
  /// The technician confirming the part reached them. Closes the custody gap
  /// between "stores says it handed over" and "the bench says it arrived".
  acknowledgedAt     DateTime? @map("acknowledged_at") @db.DateTime(3)
  acknowledgedById   String?   @map("acknowledged_by") @db.Char(36)

  // -- Proposal Module 3: the closed-loop core exchange ----------------------
  /// Where the storekeeper picks it from, captured on the picking ticket
  /// (copied from `inventory.bin_location` at reservation so the ticket still
  /// reads true if the bin is re-labelled later).
  pickBinLocation  String?   @map("pick_bin_location") @db.VarChar(50)
  /// Physically picked from the bin and handed over: "Issued to Tech" (step 3).
  issuedAt         DateTime? @map("issued_at") @db.DateTime(3)
  issuedById       String?   @map("issued_by") @db.Char(36)
  /// The NEW part's unique tracking serial, tagged to this repair ticket
  /// (step 2). `partUnitId` is the `part_units` row when the part is
  /// serial-tracked; `newSerialNo` also carries a hand-keyed serial for parts
  /// that are not in the unit register.
  partUnitId       String?   @map("part_unit_id") @db.Char(36)
  newSerialNo      String?   @map("new_serial_no") @db.VarChar(100)
  /// Snapshot of `parts.requires_core_return` at reservation time. Frozen on
  /// the line so re-classifying the catalogue later cannot retroactively
  /// unblock — or newly block — a job already in flight.
  coreRequired     Boolean   @default(false) @map("core_required")
  /// The OLD component's serial, scanned as it goes into the secure return
  /// bin (step 4). Together with `newSerialNo` this is the "New Part Serial
  /// Out vs Old Part Serial In" pair Samsung audits.
  coreSerialNo     String?   @map("core_serial_no") @db.VarChar(100)
  coreReturnedAt   DateTime? @map("core_returned_at") @db.DateTime(3)
  coreReturnedById String?   @map("core_returned_by") @db.Char(36)
  coreBinLocation  String?   @map("core_bin_location") @db.VarChar(50)

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)
  createdBy   User?    @relation("JobPartCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("JobPartUpdatedBy", fields: [updatedById], references: [id])

  company          Company @relation(fields: [companyId], references: [id])
  job              Job     @relation(fields: [jobId], references: [id])
  part             Part    @relation(fields: [partId], references: [id])
  // Proposal Module 3 — who picked it, who scanned the core back in.
  issuedBy         User?   @relation("JobPartIssuedBy", fields: [issuedById], references: [id])
  coreReturnedBy   User?   @relation("JobPartCoreReturnedBy", fields: [coreReturnedById], references: [id])
  // The bench request trail — who asked, who decided, who confirmed receipt.
  requestedBy      User?   @relation("JobPartRequestedBy", fields: [requestedById], references: [id])
  issueRequestedBy User?   @relation("JobPartIssueRequestedBy", fields: [issueRequestedById], references: [id])
  approvedBy       User?   @relation("JobPartApprovedBy", fields: [approvedById], references: [id])
  rejectedBy       User?   @relation("JobPartRejectedBy", fields: [rejectedById], references: [id])
  acknowledgedBy   User?   @relation("JobPartAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([companyId, jobId])
  @@index([partId])
  @@index([partUnitId])
  @@map("job_parts")
}

/// Stock buckets for one part at one branch (§4.4 / E10). The `qty_*` columns
/// are the materialized projection of `stock_movements`; available stock is
/// derived (`qty_on_hand − qty_reserved − qty_damaged`) in the service, never
/// stored. `reorder_level` triggers the low-stock alert / suggested reorder.
model Inventory {
  id              String  @id @default(uuid()) @db.Char(36)
  companyId       String  @map("company_id") @db.Char(36)
  branchId        String  @map("branch_id") @db.Char(36)
  partId          String  @map("part_id") @db.Char(36)
  binLocation     String? @map("bin_location") @db.VarChar(50)
  qtyOnHand       Int     @default(0) @map("qty_on_hand")
  qtyReserved     Int     @default(0) @map("qty_reserved")
  qtyInTransitIn  Int     @default(0) @map("qty_in_transit_in")
  qtyDamaged      Int     @default(0) @map("qty_damaged")
  reorderLevel    Int     @default(0) @map("reorder_level")
  /// Proposal Module 3 — the Scrap/Return Warehouse bucket: defective cores
  /// scanned back in and held for the manufacturer. Deliberately OUTSIDE the
  /// available-stock formula (on_hand − reserved − damaged): these units are
  /// faulty and owed to Samsung, so they must never be pickable.
  qtyCoreReturned Int     @default(0) @map("qty_core_returned")
  /// Where cores are physically held pending shipment (e.g. `RET-A1`).
  coreBinLocation String? @map("core_bin_location") @db.VarChar(50)

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)
  createdBy   User?    @relation("InventoryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("InventoryUpdatedBy", fields: [updatedById], references: [id])

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  part    Part    @relation(fields: [partId], references: [id])

  @@unique([branchId, partId])
  @@index([companyId, branchId])
  @@index([partId])
  @@map("inventory")
}

/// Append-only stock ledger (§4.4) — the source of truth behind every bucket.
/// NEVER updated or deleted. `qty` is signed; `ref_type`/`ref_id` link the
/// causing document (job/GRN/transfer/count); `unit_cost`+`cost_currency`
/// capture cost at the time of the movement (BIGINT minor units) for
/// valuation. `reason` is required for ADJUSTMENT/DAMAGE (enforced in service).
model StockMovement {
  id           String            @id @default(uuid()) @db.Char(36)
  companyId    String            @map("company_id") @db.Char(36)
  branchId     String            @map("branch_id") @db.Char(36)
  partId       String            @map("part_id") @db.Char(36)
  movementType StockMovementType @map("movement_type")
  qty          Int
  refType      StockRefType?     @map("ref_type")
  refId        String?           @map("ref_id") @db.Char(36)
  unitCost     BigInt?           @map("unit_cost") @db.BigInt
  costCurrency String?           @map("cost_currency") @db.Char(3)
  reason       String?           @db.Text
  movedById    String            @map("moved_by") @db.Char(36)
  movedAt      DateTime          @default(now()) @map("moved_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  part    Part    @relation(fields: [partId], references: [id])
  movedBy User    @relation("StockMovementMovedBy", fields: [movedById], references: [id])

  @@index([companyId, branchId, partId, movedAt])
  @@index([companyId, movementType, movedAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Inter-branch stock transfers (§4.4, Task 2.3).
//
// Lifecycle: DRAFT → DISPATCHED → RECEIVED (or DRAFT → CANCELLED). A transfer
// moves stock in two phases through the same ledger engine (ref_type TRANSFER):
//   - dispatch: a TRANSFER_OUT at the SOURCE (source on_hand −qty) AND bumps
//     the DESTINATION's qty_in_transit_in +qty (visibility of incoming stock);
//   - receive:  a TRANSFER_IN at the DESTINATION (dest on_hand +qty) AND clears
//     the destination's qty_in_transit_in −qty.
// Dispatch is approval-gated by value (STOCK_TRANSFER, §4.11). Available stock
// (on_hand − reserved − damaged) stays fully ledger-backed; qty_in_transit_in
// is a transient tracker MAINTAINED BY THIS FLOW (not by movements), so
// InventoryService.reconcile() rebuilds only the three ledger buckets.
//
// Like inventory/job_parts, StockTransfer is NOT extension-audited: dispatch/
// receive update its status INSIDE applyMovement's transaction, and the
// stock_movements ledger (TRANSFER_OUT/IN rows, ref_id = the transfer) is the
// trail. It is company-scoped but NOT branch-scoped (it has TWO branch columns
// — visibility is filtered in the service by from/to = the user's branch).
// ---------------------------------------------------------------------------

enum StockTransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id           String              @id @default(uuid()) @db.Char(36)
  companyId    String              @map("company_id") @db.Char(36)
  transferNo   String              @map("transfer_no") @db.VarChar(50)
  fromBranchId String              @map("from_branch_id") @db.Char(36)
  toBranchId   String              @map("to_branch_id") @db.Char(36)
  status       StockTransferStatus @default(DRAFT)
  notes        String?             @db.Text

  dispatchedAt   DateTime? @map("dispatched_at") @db.DateTime(3)
  dispatchedById String?   @map("dispatched_by") @db.Char(36)
  receivedAt     DateTime? @map("received_at") @db.DateTime(3)
  receivedById   String?   @map("received_by") @db.Char(36)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company      Company             @relation(fields: [companyId], references: [id])
  fromBranch   Branch              @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch     Branch              @relation("TransferToBranch", fields: [toBranchId], references: [id])
  dispatchedBy User?               @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id])
  receivedBy   User?               @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  createdBy    User?               @relation("TransferCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?               @relation("TransferUpdatedBy", fields: [updatedById], references: [id])
  lines        StockTransferLine[]

  @@unique([companyId, transferNo])
  @@index([companyId, status])
  @@index([companyId, fromBranchId])
  @@index([companyId, toBranchId])
  @@map("stock_transfers")
}

/// One part+qty on a transfer. No company_id — reached only via its
/// (company-scoped) transfer, like journal_lines.
model StockTransferLine {
  id         String @id @default(uuid()) @db.Char(36)
  transferId String @map("transfer_id") @db.Char(36)
  partId     String @map("part_id") @db.Char(36)
  qty        Int

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  part     Part          @relation(fields: [partId], references: [id])

  @@index([transferId])
  @@index([partId])
  @@map("stock_transfer_lines")
}

/// Per-(company, year) monotonic counter backing concurrency-safe transfer_no
/// generation (§4.4). Bumped with the same atomic MySQL idiom as JobCounter;
/// accessed ONLY via raw SQL, no relations, not audited.
model TransferCounter {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  year      Int
  nextSeq   Int    @default(0) @map("next_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([companyId, year])
  @@map("transfer_counters")
}

// ---------------------------------------------------------------------------
// Suppliers (§4.4b, Task 2.5) — the vendors we buy spares from (the Samsung
// parts distributor, local vendors). Company-level master data like the parts
// catalogue: COMPANY-scoped, audited, never branch-scoped. `lead_time_days`
// feeds reorder suggestions; `default_currency` is often USD (Samsung parts) or
// TZS (local). Supplier PERFORMANCE (E9-proc — avg delivery days, late/reject
// rates, price history) is computed from PO/GRN history in Tasks 2.6/2.7; the
// master lands here first so parts can carry a preferred supplier.
// ---------------------------------------------------------------------------

model Supplier {
  id              String  @id @default(uuid()) @db.Char(36)
  companyId       String  @map("company_id") @db.Char(36)
  name            String  @db.VarChar(255)
  contactPerson   String? @map("contact_person") @db.VarChar(255)
  phone           String? @db.VarChar(50)
  email           String? @db.VarChar(255)
  address         String? @db.VarChar(500)
  /// Default buying currency (USD for Samsung parts, TZS for local vendors).
  defaultCurrency String  @default("USD") @map("default_currency") @db.Char(3)
  /// Expected delivery time — feeds reorder suggestions (§4.4b).
  leadTimeDays    Int?    @map("lead_time_days")
  paymentTerms    String? @map("payment_terms") @db.VarChar(100)
  active          Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("SupplierUpdatedBy", fields: [updatedById], references: [id])

  company           Company         @relation(fields: [companyId], references: [id])
  preferredForParts Part[]
  purchaseOrders    PurchaseOrder[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Purchase orders (§4.4b, Task 2.6) — the order you send to a supplier.
//
// Lifecycle: DRAFT → SUBMITTED → (APPROVED) → ORDERED → PARTIALLY_RECEIVED →
// RECEIVED (or → CANCELLED before any receipt). Submitting computes whether the
// order needs manager sign-off (value ≥ the PURCHASE_ORDER threshold, §4.11); a
// PO that requires approval cannot be ORDERED until APPROVED. Receiving happens
// in Task 2.7 (GRN): a GRN posts RECEIPT movements, bumps `qty_received`, and
// flips the PO to PARTIALLY_RECEIVED / RECEIVED.
//
// Company- AND branch-scoped (branch_id = the destination branch), like jobs.
// NOT extension-audited: Task 2.7 updates the PO + its lines INSIDE the GRN's
// stock transaction, so the PO/GRN records + the stock ledger are the trail;
// the PO service emits semantic AuditService rows on lifecycle transitions.
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderLineStatus {
  PENDING
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Char(36)
  companyId  String              @map("company_id") @db.Char(36)
  poNo       String              @map("po_no") @db.VarChar(50)
  supplierId String              @map("supplier_id") @db.Char(36)
  branchId   String              @map("branch_id") @db.Char(36)
  status     PurchaseOrderStatus @default(DRAFT)
  currency   String              @db.Char(3)

  orderDate    DateTime? @map("order_date") @db.Date
  expectedDate DateTime? @map("expected_date") @db.Date

  /// Money: BIGINT minor units of `currency`. subtotal = Σ line(qty × cost);
  /// total = subtotal + tax + shipping (computed in the service).
  subtotal BigInt @default(0) @db.BigInt
  tax      BigInt @default(0) @db.BigInt
  shipping BigInt @default(0) @db.BigInt
  total    BigInt @default(0) @db.BigInt

  /// Set at submit — does this order need manager approval before ordering?
  requiresApproval Boolean   @default(false) @map("requires_approval")
  approvedById     String?   @map("approved_by") @db.Char(36)
  orderedAt        DateTime? @map("ordered_at") @db.DateTime(3)
  notes            String?   @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company    Company             @relation(fields: [companyId], references: [id])
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  branch     Branch              @relation(fields: [branchId], references: [id])
  approvedBy User?               @relation("PoApprovedBy", fields: [approvedById], references: [id])
  createdBy  User?               @relation("PoCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?               @relation("PoUpdatedBy", fields: [updatedById], references: [id])
  lines      PurchaseOrderLine[]
  grns       GoodsReceivedNote[]

  @@unique([companyId, poNo])
  @@index([companyId, status])
  @@index([companyId, branchId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

/// One part+qty on a PO. `qty_received` is a running total bumped by each GRN
/// (Task 2.7). No company_id — reached via its (company-scoped) PO.
model PurchaseOrderLine {
  id          String                  @id @default(uuid()) @db.Char(36)
  poId        String                  @map("po_id") @db.Char(36)
  partId      String                  @map("part_id") @db.Char(36)
  qtyOrdered  Int                     @map("qty_ordered")
  qtyReceived Int                     @default(0) @map("qty_received")
  unitCost    BigInt                  @map("unit_cost") @db.BigInt
  currency    String                  @db.Char(3)
  lineStatus  PurchaseOrderLineStatus @default(PENDING) @map("line_status")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  part     Part          @relation(fields: [partId], references: [id])
  grnLines GrnLine[]

  @@index([poId])
  @@index([partId])
  @@map("purchase_order_lines")
}

/// Per-(company, branch, year) monotonic counter for po_no (§4.4b) — same
/// atomic MySQL idiom as job_no; raw-SQL only, no relations, not audited.
model PurchaseOrderCounter {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  year      Int
  nextSeq   Int    @default(0) @map("next_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([companyId, branchId, year])
  @@map("purchase_order_counters")
}

// ---------------------------------------------------------------------------
// Goods received notes (§4.4b, Task 2.7) — an actual delivery against a PO.
//
// Posting a GRN is what MOVES stock: each grn_line writes a RECEIPT into
// stock_movements (ref_type GRN, ref_id = the GRN, unit_cost from the GRN),
// increments inventory.qty_on_hand, bumps purchase_order_lines.qty_received,
// and — when every line is fully received — flips the PO to RECEIVED (else
// PARTIALLY_RECEIVED). A PO can have several GRNs (partial deliveries). All of
// this happens in ONE transaction through InventoryService.applyMovement.
//
// Company- AND branch-scoped (branch_id = where stock landed = the PO's
// branch). NOT extension-audited (written inside the stock transaction); the
// stock ledger + the GRN record are the trail, plus a semantic AuditService
// CREATE row. `qty_rejected` (damaged/wrong, sent back) does NOT move stock —
// it feeds supplier performance (E9-proc).
// ---------------------------------------------------------------------------

model GoodsReceivedNote {
  id                  String   @id @default(uuid()) @db.Char(36)
  companyId           String   @map("company_id") @db.Char(36)
  grnNo               String   @map("grn_no") @db.VarChar(50)
  poId                String   @map("po_id") @db.Char(36)
  branchId            String   @map("branch_id") @db.Char(36)
  receivedDate        DateTime @map("received_date") @db.Date
  receivedById        String   @map("received_by") @db.Char(36)
  supplierDeliveryRef String?  @map("supplier_delivery_ref") @db.VarChar(100)
  notes               String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company    Company       @relation(fields: [companyId], references: [id])
  po         PurchaseOrder @relation(fields: [poId], references: [id])
  branch     Branch        @relation(fields: [branchId], references: [id])
  receivedBy User          @relation("GrnReceivedBy", fields: [receivedById], references: [id])
  lines      GrnLine[]

  @@unique([companyId, grnNo])
  @@index([companyId, branchId])
  @@index([poId])
  @@map("goods_received_notes")
}

/// One received part on a GRN. `qty_received` moved into stock this delivery;
/// `qty_rejected` was sent back. No company_id — reached via its GRN.
model GrnLine {
  id          String  @id @default(uuid()) @db.Char(36)
  grnId       String  @map("grn_id") @db.Char(36)
  poLineId    String  @map("po_line_id") @db.Char(36)
  partId      String  @map("part_id") @db.Char(36)
  qtyReceived Int     @map("qty_received")
  qtyRejected Int     @default(0) @map("qty_rejected")
  unitCost    BigInt  @map("unit_cost") @db.BigInt
  binLocation String? @map("bin_location") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  grn    GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLine PurchaseOrderLine @relation(fields: [poLineId], references: [id])
  part   Part              @relation(fields: [partId], references: [id])

  @@index([grnId])
  @@index([poLineId])
  @@index([partId])
  @@map("grn_lines")
}

/// Per-(company, branch, year) monotonic counter for grn_no (§4.4b) — same
/// atomic MySQL idiom as job_no; raw-SQL only, no relations, not audited.
model GrnCounter {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  year      Int
  nextSeq   Int    @default(0) @map("next_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([companyId, branchId, year])
  @@map("grn_counters")
}

// ---------------------------------------------------------------------------
// Serial / batch unit tracking (§4.4 / E11, Task 2.4) — enabled per part via
// parts.is_serialized. High-value parts (LCDs, PBAs) are tracked unit-by-unit
// here for recall handling, "which exact unit failed", and supplier-quality
// traceability; cheap consumables stay quantity-only (no rows here).
//
// COMPANY-scoped, deliberately NOT branch-scoped (like customers/devices): a
// serial's full history — where it is now, which job it went into — must be
// visible group-wide for recall/lookup, so `branch_id` here is the unit's
// CURRENT LOCATION, an analytics/logistics dimension, not an access boundary.
// supplier_id / grn_id / *_job_id are plain CHAR(36) provenance references with
// NO FK (validated in the service), mirroring jobs.claim_id — they point at
// branch-scoped rows the unit's owner may legitimately outlive/cross.
//
// This is an OVERLAY registry: the quantity ledger (inventory) remains the
// source of truth for available stock; part_units adds unit-level identity on
// top for serialized parts. Reconciling unit counts with qty is a future step.
// ---------------------------------------------------------------------------

enum PartUnitStatus {
  IN_STOCK
  RESERVED
  INSTALLED
  RETURNED
  DAMAGED
  /// Proposal Module 3: the defective component pulled OFF a device and
  /// scanned into the secure return bin, awaiting shipment to the
  /// manufacturer. Rows in this state are the "Scrap/Return Warehouse".
  CORE_RETURNED
  /// The core has left for the manufacturer (or been scrapped) — the 1:1
  /// exchange obligation is discharged.
  CORE_DISPATCHED
}

model PartUnit {
  id        String         @id @default(uuid()) @db.Char(36)
  companyId String         @map("company_id") @db.Char(36)
  partId    String         @map("part_id") @db.Char(36)
  /// Samsung part serial number or batch lot — unique per (company, part).
  serialNo  String         @map("serial_no") @db.VarChar(100)
  /// Current physical location.
  branchId  String         @map("branch_id") @db.Char(36)
  status    PartUnitStatus @default(IN_STOCK)

  /// Provenance + job linkage (no FK — see header note).
  supplierId       String? @map("supplier_id") @db.Char(36)
  grnId            String? @map("grn_id") @db.Char(36)
  installedOnJobId String? @map("installed_on_job_id") @db.Char(36)
  removedFromJobId String? @map("removed_from_job_id") @db.Char(36)

  warrantyExpiry DateTime? @map("warranty_expiry") @db.Date

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)
  createdBy   User?     @relation("PartUnitCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("PartUnitUpdatedBy", fields: [updatedById], references: [id])

  company Company @relation(fields: [companyId], references: [id])
  part    Part    @relation(fields: [partId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([companyId, partId, serialNo])
  @@index([companyId, serialNo])
  @@index([companyId, branchId, status])
  @@index([partId, status])
  @@map("part_units")
}

// ---------------------------------------------------------------------------
// POS & invoicing (§4.6, Task 3.1) — the sell side.
//
// An invoice is an OW sale: a repair payment (linked to a job), a parts/
// accessory sale, or a product sale. It is built as DRAFT, then payments
// (Task 3.2) move it DRAFT → PARTIAL → PAID; a void (approval-gated,
// INVOICE_VOID) makes it VOID. Money is BIGINT minor units of `currency`;
// subtotal = Σ line totals, total = subtotal − discount + tax (computed in the
// service). Company- AND branch-scoped (branch_id = selling branch, like jobs).
//
// NOT extension-audited: payment (Task 3.2) and accounting posting (Task 3.3)
// update the invoice status INSIDE their transaction, so the invoice/payment
// records + the ledger are the trail; the service emits semantic AuditService
// rows on create/void.
// ---------------------------------------------------------------------------

enum InvoiceType {
  REPAIR_OW
  PRODUCT_SALE
  PARTS_SALE
  ACCESSORY
}

enum InvoiceStatus {
  DRAFT
  PARTIAL
  PAID
  VOID
  REFUNDED
}

enum InvoiceLineType {
  PART
  PRODUCT
  SERVICE
  CUSTOM
}

model Invoice {
  id         String      @id @default(uuid()) @db.Char(36)
  companyId  String      @map("company_id") @db.Char(36)
  invoiceNo  String      @map("invoice_no") @db.VarChar(50)
  branchId   String      @map("branch_id") @db.Char(36)
  customerId String?     @map("customer_id") @db.Char(36)
  jobId      String?     @map("job_id") @db.Char(36)
  type       InvoiceType
  currency   String      @db.Char(3)

  /// BIGINT minor units. total = subtotal − discount + tax.
  subtotal BigInt @default(0) @db.BigInt
  discount BigInt @default(0) @db.BigInt
  tax      BigInt @default(0) @db.BigInt
  total    BigInt @default(0) @db.BigInt

  status   InvoiceStatus @default(DRAFT)
  soldById String        @map("sold_by") @db.Char(36)
  notes    String?       @db.Text

  // -- SCMS Module 5: out-of-warranty financial authorization ---------------
  // "The job cannot advance to REPAIRING until the customer clicks 'Approve'
  // and provides a verified digital signature or prepayment."
  //
  // A REPAIR_OW invoice in DRAFT is the QUOTE. These columns record the
  // customer's decision on it. `ow_quote_approved` (the workflow guard) reads
  // `customerApprovedAt` — an unsent, unanswered quote no longer counts as
  // consent, which is what the earlier "a quote row exists" check meant.
  /// When the secure approval link was issued to the customer.
  quoteSentAt                   DateTime? @map("quote_sent_at") @db.DateTime(3)
  quoteSentTo                   String?   @map("quote_sent_to") @db.VarChar(255)
  /// SHA-256 hex of the approval token — the raw token only ever exists in
  /// the SMS/email link, never at rest, exactly like the collection OTP.
  approvalTokenHash             String?   @map("approval_token_hash") @db.VarChar(64)
  approvalExpiresAt             DateTime? @map("approval_expires_at") @db.DateTime(3)
  /// The customer's decision.
  customerApprovedAt            DateTime? @map("customer_approved_at") @db.DateTime(3)
  customerDeclinedAt            DateTime? @map("customer_declined_at") @db.DateTime(3)
  /// How consent was captured: PORTAL (they clicked the link), COUNTER (they
  /// signed in person), PHONE (agent recorded a verbal yes), PREPAYMENT
  /// (money arrived, which the proposal accepts in place of a signature).
  approvalVia                   String?   @map("approval_via") @db.VarChar(20)
  /// The signature attachment captured with a COUNTER/PORTAL approval.
  approvalSignatureAttachmentId String?   @map("approval_signature_attachment_id") @db.Char(36)
  /// Who recorded a COUNTER/PHONE approval (NULL for a customer self-service
  /// PORTAL approval — nobody on staff touched it).
  approvalRecordedById          String?   @map("approval_recorded_by") @db.Char(36)
  approvalNote                  String?   @map("approval_note") @db.VarChar(500)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company               Company                @relation(fields: [companyId], references: [id])
  branch                Branch                 @relation(fields: [branchId], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id])
  job                   Job?                   @relation(fields: [jobId], references: [id])
  soldBy                User                   @relation("InvoiceSoldBy", fields: [soldById], references: [id])
  lines                 InvoiceLine[]
  payments              Payment[]
  warrantyRegistrations WarrantyRegistration[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, status])
  @@index([companyId, branchId, status])
  @@index([customerId])
  @@index([jobId])
  /// SCMS Module 5: the public quote-approval endpoint resolves a link by its
  /// token hash alone (the caller is the customer — they have no tenant).
  @@index([approvalTokenHash])
  @@map("invoices")
}

/// One line on an invoice. `part_id` links a PART line to the catalogue (no FK
/// for PRODUCT/SERVICE/CUSTOM). No company_id — reached via its invoice.
model InvoiceLine {
  id          String          @id @default(uuid()) @db.Char(36)
  invoiceId   String          @map("invoice_id") @db.Char(36)
  lineType    InvoiceLineType @map("line_type")
  partId      String?         @map("part_id") @db.Char(36)
  description String          @db.VarChar(500)
  qty         Int
  unitPrice   BigInt          @map("unit_price") @db.BigInt
  lineTotal   BigInt          @map("line_total") @db.BigInt
  isWarranty  Boolean         @default(false) @map("is_warranty")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  part    Part?   @relation(fields: [partId], references: [id])

  @@index([invoiceId])
  @@index([partId])
  @@map("invoice_lines")
}

/// Per-(company, branch, year) monotonic counter for invoice_no (§4.6) — same
/// atomic MySQL idiom as job_no; raw-SQL only, no relations, not audited.
model InvoiceCounter {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  year      Int
  nextSeq   Int    @default(0) @map("next_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([companyId, branchId, year])
  @@map("invoice_counters")
}

// ---------------------------------------------------------------------------
// Payments (§4.6, Task 3.2) — money in the door against an invoice.
//
// Multiple payment rows against one invoice give the DEPOSIT → BALANCE → PAID
// pattern: each POST records one payment; the invoice flips DRAFT/PARTIAL →
// PARTIAL → PAID when the running total covers it — all in ONE transaction.
// Append-only (a reversal is a separate row later); BIGINT minor units.
// Company- AND branch-scoped (branch = the invoice's). NOT extension-audited
// (written inside the payment transaction); the payment rows + the invoice
// status + the ledger (Task 3.3) are the trail, plus a semantic AuditService
// row. `PaymentMethodType` is a fixed enum (mobile money is essential in TZ) —
// distinct from the per-company `payment_methods` config table.
// ---------------------------------------------------------------------------

enum PaymentMethodType {
  CASH
  MPESA
  TIGOPESA
  AIRTEL
  CARD
  BANK
}

model Payment {
  id           String            @id @default(uuid()) @db.Char(36)
  companyId    String            @map("company_id") @db.Char(36)
  invoiceId    String            @map("invoice_id") @db.Char(36)
  branchId     String            @map("branch_id") @db.Char(36)
  method       PaymentMethodType
  amount       BigInt            @db.BigInt
  currency     String            @db.Char(3)
  /// Gateway/txn reference — the M-Pesa code, card auth, bank ref, …
  reference    String?           @db.VarChar(100)
  paidAt       DateTime          @default(now()) @map("paid_at") @db.DateTime(3)
  receivedById String            @map("received_by") @db.Char(36)
  notes        String?           @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company    Company @relation(fields: [companyId], references: [id])
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  branch     Branch  @relation(fields: [branchId], references: [id])
  receivedBy User    @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([companyId, invoiceId])
  @@index([companyId, branchId, paidAt])
  @@index([companyId, method, paidAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Warranty claims (Phase 4, §4.7 / E13) — the In-Warranty (IW) side: Samsung
// reimburses labour + parts, valued in USD and tracked by a Samsung claim
// number. A job resolves IW → one or more warranty_claims (USD); OW → invoices
// (TZS). Money is BIGINT minor units (USD cents). Task 4.1 lands the schema +
// core CRUD; the submit/reconcile lifecycle and AR–Samsung postings (§4.9:
// Dr AR–Samsung / Cr Warranty Revenue on approval; Dr Bank / Cr AR–Samsung on
// reimbursement) switch on in Task 4.2.
// ---------------------------------------------------------------------------

/// Samsung warranty labour-rate codes seen in the sales reports (§4.5 note):
/// First/Later/Subsequent Electronic-repair Module — drive the IW labour rate.
enum LabourCode {
  FEM
  LEM
  SEM
}

/// Lifecycle of a warranty claim (§4.7). CANCELLED is an approval-gated
/// withdrawal (permission `warranty.claim.cancel`), distinct from Samsung's
/// REJECTED.
enum WarrantyClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model WarrantyClaim {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  jobId     String @map("job_id") @db.Char(36)

  /// Samsung claim number (e.g. `691010338615`) — unknown until submitted, so
  /// nullable; unique per company once set (MySQL allows multiple NULLs).
  claimNo      String?     @map("claim_no") @db.VarChar(100)
  /// GSPN's other two identifiers for the same claim: `samsungRefNo` is the
  /// Samsung-side reference and `ticketNo` the inbound tracking ticket. Both
  /// appear on the Warranty Claim Detail and are how Samsung's remittance
  /// advice is matched back to a claim.
  samsungRefNo String?     @map("samsung_ref_no") @db.VarChar(100)
  ticketNo     String?     @map("ticket_no") @db.VarChar(100)
  /// GSPN's own status string, verbatim (e.g. "20-Data closed") — kept raw
  /// alongside our normalised `status` because Samsung revises this vocabulary
  /// without notice and support queries quote it exactly.
  gspnStatus   String?     @map("gspn_status") @db.VarChar(50)
  labourCode   LabourCode? @map("labour_code")

  /// BIGINT USD minor units (cents). `reimbursedAmountUsd` is the reconciled
  /// value Samsung actually paid (may differ from the claim), set on PAID.
  claimAmountUsd      BigInt  @map("claim_amount_usd") @db.BigInt
  reimbursedAmountUsd BigInt? @map("reimbursed_amount_usd") @db.BigInt

  /// The claim total broken out as GSPN settles it (Labour + Part + Shipping +
  /// Tax). `claimAmountUsd` stays authoritative; these exist so a short payment
  /// is diagnosable — without them a reimbursement gap has no attributable
  /// cause. Claims migrated from before this split carry all-zero components.
  labourAmountUsd   BigInt @default(0) @map("labour_amount_usd") @db.BigInt
  partsAmountUsd    BigInt @default(0) @map("parts_amount_usd") @db.BigInt
  shippingAmountUsd BigInt @default(0) @map("shipping_amount_usd") @db.BigInt
  taxAmountUsd      BigInt @default(0) @map("tax_amount_usd") @db.BigInt

  /// GSPN's own repair milestones. These duplicate the job's receivedAt /
  /// readyAt / dispatchedAt by design: Samsung validates a claim against the
  /// dates AS FILED, which can be corrected on the portal after the fact
  /// without rewriting the job's actual history.
  repairReceivedAt DateTime? @map("repair_received_at") @db.DateTime(3)
  completedAt      DateTime? @map("completed_at") @db.DateTime(3)
  deliveredAt      DateTime? @map("delivered_at") @db.DateTime(3)

  status      WarrantyClaimStatus @default(DRAFT)
  submittedAt DateTime?           @map("submitted_at") @db.DateTime(3)
  paidAt      DateTime?           @map("paid_at") @db.DateTime(3)
  notes       String?             @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  job       Job     @relation(fields: [jobId], references: [id])
  createdBy User?   @relation("WarrantyClaimCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("WarrantyClaimUpdatedBy", fields: [updatedById], references: [id])

  lines WarrantyClaimLine[]

  @@unique([companyId, claimNo])
  @@index([companyId, status])
  @@index([companyId, branchId, status])
  @@index([companyId, samsungRefNo])
  @@index([jobId])
  @@map("warranty_claims")
}

/// One part claimed against Samsung on a warranty claim (§4.7).
///
/// NOT `job_parts`: that table records what was physically reserved/consumed
/// from OUR stock at OUR sell price in TZS. This records what Samsung agreed to
/// REIMBURSE, in USD minor units, at their part numbering — the two diverge
/// routinely (a part fitted may be claimed at a different price, or not at all).
///
/// `partNo` is denormalised alongside `partId` on purpose: a filed claim must
/// stay legible years later even if the local catalogue renames or delists the
/// part, and Samsung part numbers are theirs to change, not ours.
model WarrantyClaimLine {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  claimId   String @map("claim_id") @db.Char(36)
  /// 1-based position as it appears on the GSPN claim detail.
  lineNo    Int    @map("line_no")

  /// Link to our catalogue when the part is one we stock; NULL for parts
  /// claimed that never passed through our inventory.
  partId      String? @map("part_id") @db.Char(36)
  partNo      String  @map("part_no") @db.VarChar(100)
  description String? @db.VarChar(500)
  location    String? @db.VarChar(100)

  qty          Int    @default(1)
  /// USD minor units (cents), like every other figure on the claim.
  unitPriceUsd BigInt @map("unit_price_usd") @db.BigInt
  amountUsd    BigInt @map("amount_usd") @db.BigInt

  /// Serial of the specific unit fitted, where the part is serialised.
  partSerialNo String? @map("part_serial_no") @db.VarChar(100)
  /// Samsung's invoice reference for the part, once billed.
  invoiceNo    String? @map("invoice_no") @db.VarChar(100)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company   Company       @relation(fields: [companyId], references: [id])
  claim     WarrantyClaim @relation(fields: [claimId], references: [id])
  part      Part?         @relation(fields: [partId], references: [id])
  createdBy User?         @relation("WarrantyClaimLineCreatedBy", fields: [createdById], references: [id])
  updatedBy User?         @relation("WarrantyClaimLineUpdatedBy", fields: [updatedById], references: [id])

  @@unique([claimId, lineNo])
  @@index([companyId])
  @@index([partId])
  @@map("warranty_claim_lines")
}

// ---------------------------------------------------------------------------
// Warranty registrations (Phase 6 / retail): a warranty the shop issues when
// it SELLS an electronic product (any brand — phones, TVs, fridges…). Distinct
// from warranty_claims (the IW claim TO Samsung, USD): this is coverage the
// customer holds ON a product they bought, so a later repair Job can tell
// whether it's under warranty (store-honoured, manufacturer, or Samsung) or
// out of warranty (customer pays). Linked to the sale invoice + device when
// known; keyed on serial for point-of-repair lookup.
// ---------------------------------------------------------------------------

/// Who honours the warranty on a sold product.
enum WarrantyKind {
  STORE // the service centre covers it
  MANUFACTURER // the product's manufacturer (any brand)
  SAMSUNG // Samsung warranty (may become an IW claim)
}

enum WarrantyRegistrationStatus {
  ACTIVE
  EXPIRED
  VOID
}

model WarrantyRegistration {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)

  customerId String? @map("customer_id") @db.Char(36)
  deviceId   String? @map("device_id") @db.Char(36)
  invoiceId  String? @map("invoice_id") @db.Char(36)

  productName String  @map("product_name") @db.VarChar(255)
  brand       String  @default("") @db.VarChar(100)
  serialNo    String? @map("serial_no") @db.VarChar(100)

  kind       WarrantyKind
  startDate  DateTime     @map("start_date") @db.Date
  expiryDate DateTime     @map("expiry_date") @db.Date
  months     Int?
  terms      String?      @db.Text

  status WarrantyRegistrationStatus @default(ACTIVE)
  notes  String?                    @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company   Company   @relation(fields: [companyId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  device    Device?   @relation(fields: [deviceId], references: [id])
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])
  createdBy User?     @relation("WarrantyRegCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("WarrantyRegUpdatedBy", fields: [updatedById], references: [id])

  /// Repair jobs whose warranty ruling was justified by THIS registration.
  jobs Job[]

  @@index([companyId, serialNo])
  @@index([companyId, status])
  @@index([companyId, expiryDate])
  @@index([customerId])
  @@map("warranty_registrations")
}

// ---------------------------------------------------------------------------
// Products (retail catalogue) — the electronics the shop SELLS (any brand),
// distinct from `parts` (Samsung repair spares). A PRODUCT_SALE invoice line
// draws from here; each product can carry a default warranty (months + kind)
// so the sale offers to register one. Stock is a simple on-hand count for now
// (the full status-bucket ledger stays parts-only).
// ---------------------------------------------------------------------------
model Product {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)

  sku        String         @db.VarChar(60)
  name       String         @db.VarChar(255)
  brand      String         @default("") @db.VarChar(100)
  /// Retail TYPE (Mobile, TV, Laptop, AC, Two-Wheeler…) — free text.
  deviceType String?        @map("device_type") @db.VarChar(50)
  category   DeviceCategory @default(OTHER)

  /// Sell price in TZS minor units (senti); optional landed cost in USD cents.
  sellPriceTzs BigInt? @map("sell_price_tzs") @db.BigInt
  costUsd      BigInt? @map("cost_usd") @db.BigInt

  stockQty Int @default(0) @map("stock_qty")

  /// Default warranty offered at sale (used to pre-fill a registration).
  defaultWarrantyMonths Int?          @map("default_warranty_months")
  defaultWarrantyKind   WarrantyKind? @map("default_warranty_kind")
  isSerialized          Boolean       @default(false) @map("is_serialized")

  active Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  @@unique([companyId, sku])
  @@index([companyId, active])
  @@map("products")
}

// ===========================================================================
// SCMS PROPOSAL MODULES — Service_Center_System_Proposal.docx
//
// Everything below implements the enterprise SCMS functional specification on
// top of the TriServe core. Section numbers refer to that document:
//
//   Module 1 (§2) Job Booking & Intake     → symptom tree, condition map
//   Module 2 (§3) Repair Lifecycle & SLA   → skills, state log, QC checklist
//   Module 3 (§4) Core Exchange            → (fields on parts/job_parts above)
//   Module 4 (§5) BER & Replacement        → ber_assessments, swap stock
//   Module 5 (§6) RBAC & Approval Matrix   → role_limits
//   Module 6 (§7) Dispatch & Hub Logistics → OTP, consignments, CSAT
//   Module 7 (§8) Architecture             → notifications outbox
// ===========================================================================

// ---------------------------------------------------------------------------
// Module 1 — Multi-tiered symptom tree (proposal §2, step 4)
//
// "Instead of letting agents write ambiguous text descriptions like 'phone
// broken', the system enforces a cascading diagnostic dropdown: Category
// (Display) → Sub-Category (Backlight) → Symptom Trigger (Flickers only when
// warm)."
//
// One SELF-REFERENCING table rather than three, so a company can run two
// levels for appliances and four for phones without a schema change. `level`
// is denormalised (1 = category, 2 = sub-category, 3+ = symptom) purely so
// the picker can load a whole tier in one query; the parent chain is the
// truth. Only a LEAF (`is_leaf`) may be attached to a job — that is what
// stops "Display" being filed as a complete diagnosis.
// ---------------------------------------------------------------------------

model SymptomNode {
  id        String          @id @default(uuid()) @db.Char(36)
  companyId String          @map("company_id") @db.Char(36)
  parentId  String?         @map("parent_id") @db.Char(36)
  /// Stable machine key, unique per company (e.g. `DISPLAY.BACKLIGHT.WARM_FLICKER`).
  code      String          @db.VarChar(120)
  label     String          @db.VarChar(255)
  /// 1 = category, 2 = sub-category, 3+ = symptom trigger.
  level     Int             @default(1)
  /// Only leaves are selectable on a job.
  isLeaf    Boolean         @default(false) @map("is_leaf")
  /// Restrict this branch of the tree to one device class (NULL = all).
  category  DeviceCategory?

  /// Routing hints the tree exists to enable (proposal: "structures data for
  /// subsequent automated routing"): the fault code this symptom maps to, the
  /// service line it belongs to, and the indicative OW labour price used for
  /// the counter's preliminary estimate.
  faultCodeId       String? @map("fault_code_id") @db.Char(36)
  serviceCategoryId String? @map("service_category_id") @db.Char(36)
  estimateAmount    BigInt? @map("estimate_amount") @db.BigInt
  estimateCurrency  String? @map("estimate_currency") @db.Char(3)
  /// Typical bench minutes — feeds the SLA/appointment estimate.
  estimateMinutes   Int?    @map("estimate_minutes")

  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company         Company          @relation(fields: [companyId], references: [id])
  parent          SymptomNode?     @relation("SymptomNodeParent", fields: [parentId], references: [id])
  children        SymptomNode[]    @relation("SymptomNodeParent")
  faultCode       FaultCode?       @relation(fields: [faultCodeId], references: [id])
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  createdBy       User?            @relation("SymptomNodeCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?            @relation("SymptomNodeUpdatedBy", fields: [updatedById], references: [id])
  jobs            Job[]

  @@unique([companyId, code])
  @@index([companyId, parentId, sortOrder])
  @@index([companyId, level, active])
  @@map("symptom_nodes")
}

// ---------------------------------------------------------------------------
// Module 1 — Dynamic visual condition mapping (proposal §2, step 3)
//
// "The agent is presented with an interactive layout mapping common physical
// damage spots… checks off pre-existing conditions… The system forces the
// agent to capture and upload high-resolution proof photos before proceeding."
//
// `condition_zones` is the CONFIGURABLE hotspot layout per device class — each
// zone carries normalised 0–1 coordinates so the same data drives a phone
// outline, a TV outline and a fridge outline without any hardcoded artwork.
// `job_condition_marks` is what the agent actually ticked on THIS device.
// ---------------------------------------------------------------------------

/// The kinds of pre-existing damage an agent can record. Deliberately a fixed
/// vocabulary (not free text) — this is the evidence that settles disputes,
/// and "scratch" vs "scratched" vs "sctach" would make it unsearchable.
enum DamageType {
  SCRATCH
  HAIRLINE_CRACK
  CRACK
  SHATTERED
  DENT
  SCUFF
  CHIP
  DISCOLOURATION
  CORROSION
  BURN
  MISSING_PART
  LOOSE_PART
  WATER_INGRESS
  LIQUID_INDICATOR_TRIPPED
  PREVIOUS_REPAIR
  OTHER
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE
}

/// One hotspot on the interactive device outline (config, per device class).
model ConditionZone {
  id        String         @id @default(uuid()) @db.Char(36)
  companyId String         @map("company_id") @db.Char(36)
  category  DeviceCategory
  code      String         @db.VarChar(60)
  label     String         @db.VarChar(120)
  /// Normalised hotspot centre on the outline, 0.0–1.0 (x = left→right,
  /// y = top→bottom). Decimal, not float: the map must render identically on
  /// every client, and these are coordinates, not measurements.
  x         Decimal        @db.Decimal(5, 4)
  y         Decimal        @db.Decimal(5, 4)
  /// Which face of the device the hotspot sits on ("FRONT", "BACK", "SIDE").
  face      String         @default("FRONT") @db.VarChar(20)
  sortOrder Int            @default(0) @map("sort_order")
  active    Boolean        @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company   Company            @relation(fields: [companyId], references: [id])
  createdBy User?              @relation("ConditionZoneCreatedBy", fields: [createdById], references: [id])
  updatedBy User?              @relation("ConditionZoneUpdatedBy", fields: [updatedById], references: [id])
  marks     JobConditionMark[]

  @@unique([companyId, category, code])
  @@index([companyId, category, active])
  @@map("condition_zones")
}

/// One piece of pre-existing damage the agent recorded on one job.
model JobConditionMark {
  id        String         @id @default(uuid()) @db.Char(36)
  companyId String         @map("company_id") @db.Char(36)
  jobId     String         @map("job_id") @db.Char(36)
  zoneId    String         @map("zone_id") @db.Char(36)
  damage    DamageType
  severity  DamageSeverity @default(MINOR)
  note      String?        @db.VarChar(500)

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  company   Company       @relation(fields: [companyId], references: [id])
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  zone      ConditionZone @relation(fields: [zoneId], references: [id])
  createdBy User?         @relation("JobConditionMarkCreatedBy", fields: [createdById], references: [id])
  updatedBy User?         @relation("JobConditionMarkUpdatedBy", fields: [updatedById], references: [id])

  @@unique([jobId, zoneId, damage])
  @@index([companyId, jobId])
  @@map("job_condition_marks")
}

// ---------------------------------------------------------------------------
// Module 2 — Technician skill matrix (proposal §3, BOOKED → ASSIGNED:
// "Technician profile must match device skill matrix.")
//
// A skill is (technician × device class), optionally narrowed to one service
// category, with a competency level. `can_qc` marks the Senior Quality
// Assurers who may sign off the QC gate for that class — the proposal makes
// QC approval a distinct authority, not just seniority.
// ---------------------------------------------------------------------------

model UserSkill {
  id                String         @id @default(uuid()) @db.Char(36)
  companyId         String         @map("company_id") @db.Char(36)
  userId            String         @map("user_id") @db.Char(36)
  category          DeviceCategory
  /// Optional narrowing to one service line (NULL = the whole device class).
  serviceCategoryId String?        @map("service_category_id") @db.Char(36)
  /// 1 = trainee … 5 = master. The assignment guard requires >= 1; routing
  /// prefers the highest.
  level             Int            @default(1)
  /// May approve the QC gate for this device class (Senior Quality Assurer).
  canQc             Boolean        @default(false) @map("can_qc")
  certifiedAt       DateTime?      @map("certified_at") @db.Date
  notes             String?        @db.VarChar(255)
  active            Boolean        @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company         Company          @relation(fields: [companyId], references: [id])
  user            User             @relation("UserSkillUser", fields: [userId], references: [id])
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  createdBy       User?            @relation("UserSkillCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?            @relation("UserSkillUpdatedBy", fields: [updatedById], references: [id])

  @@unique([userId, category, serviceCategoryId])
  @@index([companyId, category, active])
  @@map("user_skills")
}

// ---------------------------------------------------------------------------
// Module 2 — Append-only state log (proposal §3, "Time Tracking (KPI Metrics)")
//
// One row per OCCUPANCY of a state: when the job entered, when it left, and
// how long that took. Written by JobsService inside the same transaction as
// the state change, so it can never disagree with `jobs.state_id`.
//
// This is what makes Clock-to-Diagnosis, Hold-for-Parts and Total Turnaround
// computable for any past date without replaying the audit log, and what lets
// the customer-facing SLA stop while the internal clock keeps running:
// `pauses_sla` is snapshotted from the state at entry time, so re-configuring
// the workflow later never rewrites history.
// ---------------------------------------------------------------------------

model JobStateEvent {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  jobId     String @map("job_id") @db.Char(36)

  stateId     String  @map("state_id") @db.Char(36)
  /// NULL for the intake row (the job had no previous state).
  fromStateId String? @map("from_state_id") @db.Char(36)

  /// Snapshots taken at entry — see header note on why these are copied.
  stage     WorkflowStage
  holdKind  HoldKind      @default(NONE) @map("hold_kind")
  pausesSla Boolean       @default(false) @map("pauses_sla")

  enteredAt  DateTime  @map("entered_at") @db.DateTime(3)
  /// NULL while this is the CURRENT state. Exactly one open row per job.
  exitedAt   DateTime? @map("exited_at") @db.DateTime(3)
  /// Denormalised occupancy in milliseconds, written when the row closes, so
  /// the KPI aggregates are plain SUMs rather than per-row date arithmetic.
  durationMs BigInt?   @map("duration_ms") @db.BigInt

  /// Who caused the entry, and the technician holding the job at the time
  /// (so per-engineer bench time survives a later reassignment).
  actorUserId String? @map("actor_user_id") @db.Char(36)
  engineerId  String? @map("engineer_id") @db.Char(36)
  note        String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company Company       @relation(fields: [companyId], references: [id])
  branch  Branch        @relation(fields: [branchId], references: [id])
  job     Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  state   WorkflowState @relation("JobStateEventState", fields: [stateId], references: [id])

  @@index([companyId, jobId, enteredAt])
  @@index([companyId, stage, enteredAt])
  @@index([jobId, exitedAt])
  @@map("job_state_events")
}

// ---------------------------------------------------------------------------
// Module 2 — Mandatory calibration logs (proposal §3)
//
// "Before a device exits the QC phase, the system requires completion of a
// structural checklist tailored to the device class. For example, flagship
// mobile devices must pass an automated pressure/water-resistance calibration
// test, with raw log files uploaded to the record."
//
// `qc_checklist_items` is the per-device-class template (config);
// `job_qc_checks` is the filled-in result for one QC attempt. `attempt_no`
// keeps every round after a rejection instead of overwriting — a device that
// failed water-resistance twice must look different from one that passed
// first time.
// ---------------------------------------------------------------------------

enum QcCheckResult {
  PASS
  FAIL
  NA
}

model QcChecklistItem {
  id                 String         @id @default(uuid()) @db.Char(36)
  companyId          String         @map("company_id") @db.Char(36)
  category           DeviceCategory
  code               String         @db.VarChar(60)
  label              String         @db.VarChar(255)
  /// Short instruction shown to the Quality Assurer.
  help               String?        @db.VarChar(500)
  /// A measured reading must be typed in (e.g. pressure test kPa), not just
  /// a tick.
  requiresValue      Boolean        @default(false) @map("requires_value")
  /// A raw log/measurement FILE must be attached to the job before the item
  /// can pass — the proposal's "raw log files uploaded to the record".
  requiresAttachment Boolean        @default(false) @map("requires_attachment")
  /// When false the item is advisory: it must be ANSWERED but may be failed
  /// or marked N/A without blocking the gate.
  blocking           Boolean        @default(true)
  sortOrder          Int            @default(0) @map("sort_order")
  active             Boolean        @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company   Company      @relation(fields: [companyId], references: [id])
  createdBy User?        @relation("QcChecklistItemCreatedBy", fields: [createdById], references: [id])
  updatedBy User?        @relation("QcChecklistItemUpdatedBy", fields: [updatedById], references: [id])
  checks    JobQcCheck[]

  @@unique([companyId, category, code])
  @@index([companyId, category, active])
  @@map("qc_checklist_items")
}

model JobQcCheck {
  id        String        @id @default(uuid()) @db.Char(36)
  companyId String        @map("company_id") @db.Char(36)
  jobId     String        @map("job_id") @db.Char(36)
  itemId    String        @map("item_id") @db.Char(36)
  /// 1 for the first QC round, 2 after the first rejection, …
  attemptNo Int           @default(1) @map("attempt_no")
  result    QcCheckResult
  /// The measured reading, when the item requires one.
  value     String?       @db.VarChar(120)
  note      String?       @db.VarChar(500)

  recordedById String   @map("recorded_by") @db.Char(36)
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company    Company         @relation(fields: [companyId], references: [id])
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item       QcChecklistItem @relation(fields: [itemId], references: [id])
  recordedBy User            @relation("JobQcCheckRecordedBy", fields: [recordedById], references: [id])

  @@unique([jobId, itemId, attemptNo])
  @@index([companyId, jobId, attemptNo])
  @@map("job_qc_checks")
}

// ---------------------------------------------------------------------------
// Module 4 — Beyond Economic Repair & Replacement (proposal §5)
//
// Step 1 fires automatically: when (estimated SKU parts + estimated labour)
// reaches `companies.ber_threshold_percent` of the device's fair commercial
// market value, the standard track HALTS and a BER assessment is written in
// FLAGGED. Step 2 locks the technician out (`jobs.tech_locked`) and hands
// ownership to the Workshop Supervisor, who certifies or rejects — an
// approval-gated action (ApprovalType.BER_CERTIFICATION) producing a
// numbered certificate. Steps 3–5 record what the customer chose and, for a
// replacement, the swap.
//
// Every input is SNAPSHOTTED on the row: re-pricing a part next month must
// not silently change what the supervisor certified, and the certificate is
// a document the manufacturer may audit years later.
// ---------------------------------------------------------------------------

enum BerStatus {
  /// The formula tripped; awaiting supervisor review.
  FLAGGED
  /// Supervisor certified the device Beyond Economic Repair.
  CERTIFIED
  /// Supervisor reviewed and put the job back on the standard repair track.
  REJECTED
  /// Superseded by a newer evaluation, or the job moved on.
  WITHDRAWN
}

/// What the customer chose once BER was certified (proposal §5 step 3).
enum BerOutcome {
  /// In-warranty factory fault → replacement pipeline.
  REPLACE_IW
  /// Out-of-warranty → customer bought a discounted replacement.
  REPLACE_TRADE_UP
  /// Out-of-warranty → customer took the salvage value and left the unit.
  SALVAGE
  /// Customer declined everything and took the device back unrepaired.
  DECLINED
  /// Certified BER but the customer insisted on the repair anyway.
  REPAIR_ANYWAY
}

model BerAssessment {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  jobId     String @map("job_id") @db.Char(36)

  /// Human-facing certificate number, allocated ONLY on certification:
  /// `BER-{BRANCH}-{YYYY}-{seq}`. NULL while FLAGGED.
  certificateNo String? @map("certificate_no") @db.VarChar(50)

  // -- The formula, snapshotted (all minor units of `currency`) -------------
  partsCost        BigInt  @map("parts_cost") @db.BigInt
  labourCost       BigInt  @map("labour_cost") @db.BigInt
  totalCost        BigInt  @map("total_cost") @db.BigInt
  deviceValue      BigInt  @map("device_value") @db.BigInt
  currency         String  @db.Char(3)
  /// totalCost / deviceValue as a percentage, to 2 dp.
  ratioPercent     Decimal @map("ratio_percent") @db.Decimal(9, 2)
  /// The company threshold in force when this ran (default 70).
  thresholdPercent Int     @map("threshold_percent")
  /// Where `deviceValue` came from — DEVICE (per-unit override), MODEL
  /// (catalogue figure) or MANUAL (supervisor keyed it in). Without this,
  /// a certificate cannot be defended.
  valuationSource  String  @map("valuation_source") @db.VarChar(20)

  status BerStatus @default(FLAGGED)

  flaggedAt     DateTime  @default(now()) @map("flagged_at") @db.DateTime(3)
  reviewedById  String?   @map("reviewed_by") @db.Char(36)
  reviewedAt    DateTime? @map("reviewed_at") @db.DateTime(3)
  decisionNotes String?   @map("decision_notes") @db.Text

  outcome             BerOutcome?
  customerRespondedAt DateTime?   @map("customer_responded_at") @db.DateTime(3)
  /// Salvage value offered / trade-up discount, minor units of `currency`.
  offerAmount         BigInt?     @map("offer_amount") @db.BigInt

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  company    Company      @relation(fields: [companyId], references: [id])
  branch     Branch       @relation(fields: [branchId], references: [id])
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("BerAssessmentReviewedBy", fields: [reviewedById], references: [id])
  createdBy  User?        @relation("BerAssessmentCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?        @relation("BerAssessmentUpdatedBy", fields: [updatedById], references: [id])
  swaps      DeviceSwap[]

  @@unique([companyId, certificateNo])
  @@index([companyId, jobId, flaggedAt])
  @@index([companyId, branchId, status])
  @@map("ber_assessments")
}

/// Per-(company, branch, year) counter backing BER certificate numbers.
/// Same atomic MySQL sequence idiom as JobCounter — raw SQL only.
model BerCertificateCounter {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  year      Int
  nextSeq   Int    @default(0) @map("next_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([companyId, branchId, year])
  @@map("ber_certificate_counters")
}

// ---------------------------------------------------------------------------
// Module 4, step 4 — Swap Buffer Stock (proposal §5)
//
// "The system issues a new unit from a strictly isolated inventory segment
// known as the 'Swap Buffer Stock' (which contains unboxed, replacement-only
// units). The system blocks standard commercial inventory access for this
// step."
//
// The isolation is STRUCTURAL, not a flag on a shared table: swap units live
// in their own table that the POS, the parts ledger and the products
// catalogue simply cannot see. There is no query that can accidentally sell
// one over the counter, because no selling code path joins here.
// ---------------------------------------------------------------------------

enum SwapUnitStatus {
  IN_STOCK
  /// Committed to a specific job, not yet handed over.
  ALLOCATED
  /// Handed to the customer — the swap is done.
  ISSUED
  /// Withdrawn from the buffer (damaged, recalled, returned to Samsung).
  RETIRED
}

model SwapUnit {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  /// Where the unit physically sits.
  branchId  String @map("branch_id") @db.Char(36)

  modelId    String?        @map("model_id") @db.Char(36)
  /// Free-text model when it predates the catalogue entry.
  modelLabel String?        @map("model_label") @db.VarChar(150)
  category   DeviceCategory @default(HHP)
  /// The replacement unit's own IMEI/serial — becomes the customer's new
  /// primary tracking identity on issue. Normalised like `devices.imei_serial`.
  imeiSerial String         @map("imei_serial") @db.VarChar(100)
  color      String?        @db.VarChar(50)

  /// Acquisition cost, minor units of `currency` (for the swap's COGS).
  cost     BigInt? @db.BigInt
  currency String? @db.Char(3)

  status         SwapUnitStatus @default(IN_STOCK)
  allocatedJobId String?        @map("allocated_job_id") @db.Char(36)
  allocatedAt    DateTime?      @map("allocated_at") @db.DateTime(3)
  issuedAt       DateTime?      @map("issued_at") @db.DateTime(3)
  issuedById     String?        @map("issued_by") @db.Char(36)
  /// Provenance (which delivery it arrived on) — no FK, like PartUnit.
  grnId          String?        @map("grn_id") @db.Char(36)
  notes          String?        @db.VarChar(500)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company   Company      @relation(fields: [companyId], references: [id])
  branch    Branch       @relation(fields: [branchId], references: [id])
  model     DeviceModel? @relation(fields: [modelId], references: [id])
  issuedBy  User?        @relation("SwapUnitIssuedBy", fields: [issuedById], references: [id])
  createdBy User?        @relation("SwapUnitCreatedBy", fields: [createdById], references: [id])
  updatedBy User?        @relation("SwapUnitUpdatedBy", fields: [updatedById], references: [id])
  swaps     DeviceSwap[]

  @@unique([companyId, imeiSerial])
  @@index([companyId, branchId, status])
  @@index([allocatedJobId])
  @@map("swap_units")
}

/// Module 4, step 5 — the executed replacement + primary identity realignment.
/// One row per swap; it is the join that lets device history walk from the
/// decommissioned IMEI to the live one.
model DeviceSwap {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  jobId     String @map("job_id") @db.Char(36)

  /// The unit that came in and is now decommissioned.
  oldDeviceId String @map("old_device_id") @db.Char(36)
  /// The `devices` row created FOR the replacement (same customer, new IMEI).
  newDeviceId String @map("new_device_id") @db.Char(36)
  swapUnitId  String @map("swap_unit_id") @db.Char(36)

  berAssessmentId String? @map("ber_assessment_id") @db.Char(36)
  /// Snapshot of the old IMEI: `devices` rows can be edited, and the audit
  /// question "which identity was retired here" must stay answerable.
  oldImeiSerial   String? @map("old_imei_serial") @db.VarChar(100)
  newImeiSerial   String? @map("new_imei_serial") @db.VarChar(100)
  /// How many historical jobs were carried across to the new identity.
  historyJobCount Int     @default(0) @map("history_job_count")

  reason         String?  @db.VarChar(500)
  authorizedById String   @map("authorized_by") @db.Char(36)
  authorizedAt   DateTime @default(now()) @map("authorized_at") @db.DateTime(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)

  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  oldDevice     Device         @relation("DeviceSwapOld", fields: [oldDeviceId], references: [id])
  newDevice     Device         @relation("DeviceSwapNew", fields: [newDeviceId], references: [id])
  swapUnit      SwapUnit       @relation(fields: [swapUnitId], references: [id])
  berAssessment BerAssessment? @relation(fields: [berAssessmentId], references: [id])
  authorizedBy  User           @relation("DeviceSwapAuthorizedBy", fields: [authorizedById], references: [id])
  createdBy     User?          @relation("DeviceSwapCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, jobId])
  @@index([oldDeviceId])
  @@index([newDeviceId])
  @@map("device_swaps")
}

// ---------------------------------------------------------------------------
// Module 5 — Financial ceilings per role (proposal §6 approval matrix)
//
//   Front Counter Agent — takes payment, CANNOT grant discounts.
//   Repair Technician   — parts to diagnostic codes up to a minor variance.
//   Floor Supervisor    — OW price adjustments up to a ceiling; no write-offs.
//   Centre Manager      — full authority.
//
// Expressed as DATA keyed on the role KEY (built-in or custom), exactly like
// `role_permissions`, so a company can retune the ceilings without a deploy.
// A permission answers "may you do this at all"; a limit answers "how far".
// NO ROW = no authority (deny), which is why the seed writes an explicit
// zero-amount row for the front counter rather than leaving it absent — the
// two are indistinguishable to a reader otherwise, so the seed is explicit
// and `enabled=false` is the way to say "unlimited".
// ---------------------------------------------------------------------------

enum RoleLimitType {
  /// Percentage or absolute discount on a POS/repair invoice.
  DISCOUNT
  /// Adjusting an agreed OW price up or down.
  PRICE_ADJUSTMENT
  /// Consumable/parts value a technician may commit beyond the diagnosis.
  PARTS_VARIANCE
  /// Writing off a repair, a stock loss, or a BER unit.
  WRITE_OFF
  /// Cash back to a customer.
  REFUND
}

model RoleLimit {
  id        String        @id @default(uuid()) @db.Char(36)
  companyId String        @map("company_id") @db.Char(36)
  /// A role KEY — built-in or custom, like `role_permissions.role`.
  role      String        @db.VarChar(50)
  type      RoleLimitType

  /// Ceiling in minor units of `currency`. NULL = no amount ceiling.
  maxAmount  BigInt?  @map("max_amount") @db.BigInt
  currency   String?  @db.Char(3)
  /// Ceiling as a percentage of the document total (discounts). NULL = none.
  maxPercent Decimal? @map("max_percent") @db.Decimal(6, 3)
  /// false = this role has NO ceiling for this action (unlimited). Distinct
  /// from a missing row, which denies.
  enabled    Boolean  @default(true)

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("RoleLimitCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("RoleLimitUpdatedBy", fields: [updatedById], references: [id])

  @@unique([companyId, role, type])
  @@index([companyId, role])
  @@map("role_limits")
}

// ---------------------------------------------------------------------------
// Module 6 — Secure OTP handshake (proposal §7, steps 1 & 4)
//
// "When a job transitions to READY_FOR_COLLECTION, the system generates a
// secure, randomized, single-use 6-digit One-Time PIN sent directly to the
// customer's registered mobile number… The system blocks the agent from
// selecting 'Delivered' until the entered PIN matches."
//
// The PIN is NEVER stored: only a SHA-256 hash, exactly like refresh tokens
// in `sessions`. A counter agent with database access must not be able to
// read the code that authorises a handover — that would defeat the control.
// Re-issuing supersedes the previous row rather than mutating it, so the
// dispatch trail shows every PIN ever sent.
// ---------------------------------------------------------------------------

model JobCollectionOtp {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  jobId     String @map("job_id") @db.Char(36)

  /// SHA-256 hex of the 6-digit PIN — see header note.
  codeHash String @map("code_hash") @db.VarChar(64)
  /// Last 2 digits, shown to staff so they can help a customer who says
  /// "…ends in 47" without ever revealing the full code.
  codeHint String @map("code_hint") @db.Char(2)

  /// Where it was sent (the customer's number at the time of issue).
  sentTo       String?   @map("sent_to") @db.VarChar(50)
  sentAt       DateTime? @map("sent_at") @db.DateTime(3)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  attempts     Int       @default(0)
  verifiedAt   DateTime? @map("verified_at") @db.DateTime(3)
  verifiedById String?   @map("verified_by") @db.Char(36)
  /// Set when a newer PIN supersedes this one, or the attempt cap is hit.
  voidedAt     DateTime? @map("voided_at") @db.DateTime(3)
  voidReason   String?   @map("void_reason") @db.VarChar(255)

  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById String?  @map("created_by") @db.Char(36)

  company    Company @relation(fields: [companyId], references: [id])
  branch     Branch  @relation(fields: [branchId], references: [id])
  job        Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("JobCollectionOtpVerifiedBy", fields: [verifiedById], references: [id])
  createdBy  User?   @relation("JobCollectionOtpCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, jobId, createdAt])
  @@index([jobId, verifiedAt, voidedAt])
  @@map("job_collection_otps")
}

// ---------------------------------------------------------------------------
// Module 6 — Consignments, totes & chain of custody (proposal §7, steps 2–3)
//
// "If the device was dropped off at a satellite collection point rather than
// the main repair hub… The system assigns a distinct tracking label to a
// secure 'Logistics Tote' and bundles all outbound devices into a unified
// digital consignment manifest… At each point along the chain handlers must
// scan the barcode on the tote."
//
// A consignment IS the tote: one physical container, one manifest, many jobs.
// Scans are append-only — a chain of custody you can edit is not a chain of
// custody.
// ---------------------------------------------------------------------------

enum ConsignmentStatus {
  /// Being packed at the origin; jobs can still be added or removed.
  OPEN
  /// Sealed and handed to the courier.
  IN_TRANSIT
  /// Received at the destination; contents checked in.
  ARRIVED
  CANCELLED
}

/// Which leg of the hub-and-spoke journey this consignment covers.
enum ConsignmentDirection {
  /// Satellite drop point → main repair hub (device coming in for repair).
  INBOUND_TO_HUB
  /// Main repair hub → satellite storefront (repaired device going back).
  OUTBOUND_TO_SPOKE
}

model Consignment {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)

  /// `CON-{FROM}-{YYYY}-{seq}` — the manifest reference.
  consignmentNo String @map("consignment_no") @db.VarChar(50)
  /// The barcode printed on the physical tote. Separate from
  /// `consignment_no` because totes are REUSED: the same tote label carries a
  /// different manifest next week, and scanning must resolve to the manifest
  /// that is currently in flight.
  toteLabel     String @map("tote_label") @db.VarChar(60)

  fromBranchId String               @map("from_branch_id") @db.Char(36)
  toBranchId   String               @map("to_branch_id") @db.Char(36)
  direction    ConsignmentDirection

  status ConsignmentStatus @default(OPEN)

  courierName String? @map("courier_name") @db.VarChar(120)
  courierRef  String? @map("courier_ref") @db.VarChar(120)
  /// The customer-facing waybill number, when the courier issues one.
  waybillNo   String? @map("waybill_no") @db.VarChar(100)

  sealedAt       DateTime? @map("sealed_at") @db.DateTime(3)
  dispatchedAt   DateTime? @map("dispatched_at") @db.DateTime(3)
  dispatchedById String?   @map("dispatched_by") @db.Char(36)
  arrivedAt      DateTime? @map("arrived_at") @db.DateTime(3)
  arrivedById    String?   @map("arrived_by") @db.Char(36)
  notes          String?   @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company      Company           @relation(fields: [companyId], references: [id])
  fromBranch   Branch            @relation("ConsignmentFromBranch", fields: [fromBranchId], references: [id])
  toBranch     Branch            @relation("ConsignmentToBranch", fields: [toBranchId], references: [id])
  dispatchedBy User?             @relation("ConsignmentDispatchedBy", fields: [dispatchedById], references: [id])
  arrivedBy    User?             @relation("ConsignmentArrivedBy", fields: [arrivedById], references: [id])
  createdBy    User?             @relation("ConsignmentCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?             @relation("ConsignmentUpdatedBy", fields: [updatedById], references: [id])
  jobs         ConsignmentJob[]
  scans        ConsignmentScan[]

  @@unique([companyId, consignmentNo])
  @@index([companyId, status, createdAt])
  @@index([companyId, toteLabel])
  @@map("consignments")
}

/// One job riding in one consignment (the manifest line).
model ConsignmentJob {
  id            String @id @default(uuid()) @db.Char(36)
  companyId     String @map("company_id") @db.Char(36)
  consignmentId String @map("consignment_id") @db.Char(36)
  jobId         String @map("job_id") @db.Char(36)

  addedAt       DateTime  @default(now()) @map("added_at") @db.DateTime(3)
  addedById     String?   @map("added_by") @db.Char(36)
  /// Checked off against the manifest on arrival. A NULL here on an ARRIVED
  /// consignment is a MISSING DEVICE — the whole point of the manifest.
  checkedInAt   DateTime? @map("checked_in_at") @db.DateTime(3)
  checkedInById String?   @map("checked_in_by") @db.Char(36)
  note          String?   @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company     Company     @relation(fields: [companyId], references: [id])
  consignment Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  addedBy     User?       @relation("ConsignmentJobAddedBy", fields: [addedById], references: [id])
  checkedInBy User?       @relation("ConsignmentJobCheckedInBy", fields: [checkedInById], references: [id])

  @@unique([consignmentId, jobId])
  @@index([companyId, jobId])
  @@map("consignment_jobs")
}

/// Where the tote was scanned. CUSTOM covers anything a company adds without
/// needing a migration — `location` carries the free-text detail either way.
enum ScanPoint {
  HUB_DEPART
  COURIER_HUB
  COURIER_DEPART
  SPOKE_ARRIVE
  HUB_ARRIVE
  CUSTOM
}

/// APPEND-ONLY chain-of-custody scan. Never updated, never deleted.
model ConsignmentScan {
  id            String @id @default(uuid()) @db.Char(36)
  companyId     String @map("company_id") @db.Char(36)
  consignmentId String @map("consignment_id") @db.Char(36)

  scanPoint   ScanPoint @map("scan_point")
  location    String?   @db.VarChar(255)
  scannedAt   DateTime  @default(now()) @map("scanned_at") @db.DateTime(3)
  /// NULL when a courier's own handheld posted the scan via an integration
  /// rather than a logged-in user.
  scannedById String?   @map("scanned_by") @db.Char(36)
  handlerName String?   @map("handler_name") @db.VarChar(120)
  note        String?   @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  company     Company     @relation(fields: [companyId], references: [id])
  consignment Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  scannedBy   User?       @relation("ConsignmentScanScannedBy", fields: [scannedById], references: [id])

  @@index([companyId, consignmentId, scannedAt])
  @@map("consignment_scans")
}

/// Per-(company, branch, year) counter for consignment numbers — raw SQL only,
/// same idiom as JobCounter.
model ConsignmentCounter {
  id        String @id @default(uuid()) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  branchId  String @map("branch_id") @db.Char(36)
  year      Int
  nextSeq   Int    @default(0) @map("next_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([companyId, branchId, year])
  @@map("consignment_counters")
}

// ---------------------------------------------------------------------------
// Module 6, step 5 — CSAT (proposal §7)
//
// "…fires a customer satisfaction (CSAT) survey link." The token is the
// customer's credential: it is unguessable, single-purpose, expiring, and
// grants read/write to exactly ONE survey row and nothing else.
// ---------------------------------------------------------------------------

model CsatSurvey {
  id         String @id @default(uuid()) @db.Char(36)
  companyId  String @map("company_id") @db.Char(36)
  branchId   String @map("branch_id") @db.Char(36)
  jobId      String @map("job_id") @db.Char(36)
  customerId String @map("customer_id") @db.Char(36)

  /// URL-safe random token identifying the public survey link.
  token     String    @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  sentAt    DateTime? @map("sent_at") @db.DateTime(3)

  /// 1–5. NULL until the customer answers.
  score       Int?      @db.TinyInt
  comment     String?   @db.Text
  respondedAt DateTime? @map("responded_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company  Company  @relation(fields: [companyId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([token])
  @@index([companyId, branchId, respondedAt])
  @@index([companyId, jobId])
  @@map("csat_surveys")
}

// ---------------------------------------------------------------------------
// Module 7 — Notification engine + asynchronous outbox (proposal §8;
// DESIGN.md §4.13 / E6)
//
// "Build the system using asynchronous worker queues to handle heavy
// operations like third-party warranty verification lookups, SMS delivery,
// invoice generation and customer email alerts. This ensures the frontend
// stays responsive for front-desk staff."
//
// The queue is a DATABASE TABLE, not Redis. Deliberate: the deployment is a
// single managed MySQL with daily backups (§9), and a durable outbox in the
// same database as the business row means "the job card was created" and
// "the SMS was queued" commit or fail together. No second system to keep
// alive, no lost message when a broker restarts, and the retry history is
// queryable with SQL. The trade-off — polling latency and no fan-out across
// many workers — is the right one at this scale; swapping in a broker later
// means changing the drain loop, not the call sites.
//
// `notifications` doubles as the CRM communication log (§4.13).
// ---------------------------------------------------------------------------

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  /// Delivered inside the app only (no external provider).
  IN_APP
}

enum NotificationStatus {
  QUEUED
  /// Claimed by a worker; guards against two workers sending the same row.
  SENDING
  SENT
  /// Failed and out of retries. `last_error` says why.
  FAILED
  CANCELLED
}

/// Per-company, per-event, per-channel, per-language message body. Bodies use
/// `{{placeholder}}` tokens resolved from the event payload.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Char(36)
  companyId String              @map("company_id") @db.Char(36)
  /// e.g. `JOB_READY`, `COLLECTION_OTP`, `QUOTE_APPROVAL`, `CSAT_REQUEST`.
  eventCode String              @map("event_code") @db.VarChar(60)
  channel   NotificationChannel
  language  PreferredLanguage   @default(EN)
  subject   String?             @db.VarChar(255)
  body      String              @db.Text
  active    Boolean             @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdById String?   @map("created_by") @db.Char(36)
  updatedById String?   @map("updated_by") @db.Char(36)

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("NotificationTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("NotificationTemplateUpdatedBy", fields: [updatedById], references: [id])

  @@unique([companyId, eventCode, channel, language])
  @@index([companyId, eventCode])
  @@map("notification_templates")
}

/// One queued/sent message — the durable outbox AND the comms log.
model Notification {
  id        String  @id @default(uuid()) @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  branchId  String? @map("branch_id") @db.Char(36)

  customerId String? @map("customer_id") @db.Char(36)
  jobId      String? @map("job_id") @db.Char(36)
  /// The signed-in user this is for, when it is an internal alert.
  userId     String? @map("user_id") @db.Char(36)

  eventCode String              @map("event_code") @db.VarChar(60)
  channel   NotificationChannel
  language  PreferredLanguage   @default(EN)
  /// Phone number / email address, resolved at enqueue time.
  toAddress String              @map("to_address") @db.VarChar(255)
  subject   String?             @db.VarChar(255)
  /// The RENDERED body. Stored rather than re-rendered so the comms log shows
  /// exactly what the customer received, even after the template changes.
  body      String              @db.Text
  /// The event data the body was rendered from — kept for debugging a bad
  /// render, and deliberately free-form.
  payload   Json?

  status      NotificationStatus @default(QUEUED)
  attempts    Int                @default(0)
  /// Earliest time a worker may pick this up — the retry backoff lives here.
  availableAt DateTime           @default(now()) @map("available_at") @db.DateTime(3)
  sentAt      DateTime?          @map("sent_at") @db.DateTime(3)
  /// Provider message id (Beem/Africa's Talking), for delivery-report lookup.
  providerRef String?            @map("provider_ref") @db.VarChar(255)
  lastError   String?            @map("last_error") @db.Text
  /// Set while a worker holds the row; a stale lease is reclaimable.
  leasedUntil DateTime?          @map("leased_until") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company  Company   @relation(fields: [companyId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// The drain loop's hot path: "QUEUED and due, oldest first".
  @@index([status, availableAt])
  @@index([companyId, customerId, createdAt])
  @@index([companyId, jobId, createdAt])
  @@index([companyId, eventCode, createdAt])
  @@map("notifications")
}
